#!/usr/bin/env bash
# nolock — skip the password prompt when the laptop wakes, lid or sleep.
#
# On XFCE this had to turn off five switches across two daemons, and the one
# that took longest to find was the lid pair — because closing the lid never
# slept the machine, it locked it directly, so none of the sleep-related
# switches ever got a say.
#
# Under niri the shape is different and smaller. niri does not lock; noctalia
# does, and logind decides what the lid means. That leaves three switches that
# can put a password prompt in front of you, all of them noctalia's:
#
#   lockscreen.lock_before_suspend
#           The direct heir to xfce4-screensaver's /lock/sleep-activation, and
#           the one that actually catches you: noctalia holds a logind sleep
#           *delay* inhibitor ("Lock before sleep" in `systemd-inhibit --list`)
#           and raises the lock screen on the way down. Default true.
#   idle.behavior.lock.enabled
#   idle.behavior.lock-and-suspend.enabled
#           Lock after an idle timeout, with and without suspending. Both ship
#           disabled, so on a stock install they cost nothing — they are here
#           so that turning one on later does not silently defeat nolock.
#
# lockscreen.enabled is deliberately left alone. It is the master switch, and
# with it on Super+Alt+L still locks on demand while nolock is on — exactly the
# reasoning that kept /lock/enabled untouched in the XFCE version.
#
# WHAT DOES NOT TRANSFER: THE LID
#
# The lid pair has no equivalent here. xfce4-power-manager held a logind
# handle-lid-switch inhibitor and decided for itself what a lid close meant,
# which is why it could be told "blank the screen" instead of "lock". Nothing
# in this session takes that inhibitor, so the lid is logind's again, and
# logind's HandleLidSwitch lives in /etc/systemd/logind.conf — root-owned
# system configuration, not a per-user toggle. Changing it is a different kind
# of act from flipping a setting in your own session, so nolock reports it and
# does not touch it.
#
# Since 2026-10-09 that reported value is `lock`, not the stock `suspend`, set
# by nolock/20-lid-lock.conf. The reason is not about passwords at all: logind's
# `suspend` freezes the whole of user.slice on the way down, which made the lid
# the only thing in this session that stopped a running process. A lid close now
# locks and blanks and leaves work running.
#
# THE KNOCK-ON FOR NOLOCK, which is a real loss and not a detail: nolock can no
# longer skip the password prompt on a lid close. It never could change the lid
# action, only the switches on the *sleep* path, and the lid is not on that path
# any more -- lock_before_suspend is what nolock turns off, and a lid close no
# longer goes near it. The prompt now comes from logind's own `lock` action,
# which reaches noctalia through the session Lock signal and is gated only by
# lockscreen.enabled, the master switch nolock deliberately leaves alone.
#
# So the old behaviour of "nolock on, shut the lid, open it straight back into
# the session" is gone, and it was traded for the lid not stopping your
# processes. `nolock on` still does exactly what it says for an actual suspend.
# If the wake-without-asking mattered more, the lid action is the thing to
# change back -- see nolock/20-lid-lock.conf.
#
# WHY THERE ARE FIVE COLUMNS BELOW AND NOT FOUR
#
# The XFCE version got away with one value doing double duty: for all five of
# its keys, the value meaning "this would lock" was also the compiled-in
# default, so an unset key read as locking and restored to the value it would
# have had anyway. That coincidence does not hold here. lock_before_suspend
# defaults to true (locking) and both idle behaviours default to false (not
# locking), so "what does unset mean" and "what do I write to make it lock
# again" are now genuinely different questions and get a column each.
#
# The state is the settings themselves rather than a file beside them, so it
# survives a reboot and can't drift from what noctalia is actually doing. The
# file this does keep is a snapshot of the pre-nolock values, so `off` restores
# what was there instead of assuming the defaults.
#
# Usage: nolock [status|on|off|toggle] [--quiet]

set -euo pipefail

SRC="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SETTING="$SRC/noctalia-setting.py"
# shellcheck source=../lib/niri.sh
. "$SRC/../lib/niri.sh"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nolock"
SAVED="$STATE_DIR/saved"

# Which lock stack is in front of this session. Both are real; neither is a
# fallback. `nolock` means the same thing in either — "waking does not ask for
# a password" — and the switches that have to move to achieve it are simply
# different objects owned by different daemons.
BACKEND=$(session_kind)

# Every row: <container><TAB><key><TAB><nolock value><TAB><locking value><TAB><default>
#
# The fifth column exists because of a coincidence that holds under XFCE and
# not under noctalia. On XFCE, for all five keys, the value meaning "this
# would lock" is also the compiled-in default, so an unset key reads as
# locking and restores to the value it would have had anyway. noctalia breaks
# that: lock_before_suspend defaults to true (locking) while both idle
# behaviours default to false (not locking), so "what does unset mean" and
# "what do I write to make it lock again" stopped being the same question.
# Carrying the default explicitly makes both tables answerable by one rule.
case $BACKEND in
	niri)
		KEYS=(
			"lockscreen	lock_before_suspend	false	true	true"
			"idle.behavior.lock	enabled	false	true	false"
			"idle.behavior.lock-and-suspend	enabled	false	true	false"
		)
		;;
	x11)
		KEYS=(
			"xfce4-power-manager	/xfce4-power-manager/lock-screen-suspend-hibernate	false	true	true"
			"xfce4-screensaver	/lock/sleep-activation	false	true	true"
			"xfce4-screensaver	/lock/saver-activation/enabled	false	true	true"
			"xfce4-power-manager	/xfce4-power-manager/lid-action-on-ac	0	3	3"
			"xfce4-power-manager	/xfce4-power-manager/lid-action-on-battery	0	3	3"
		)
		;;
	*)
		echo "nolock: no niri session and no X display — nothing to configure" >&2
		exit 1
		;;
esac

# xfconf needs a type to create a property; noctalia's TOML does not. Only the
# X11 table has non-boolean rows (the lid pair is a seven-member enum where
# only 3, "lock screen", locks).
xfconf_type() { # property -> bool|uint
	case "$1" in
		*/lid-action-on-*) echo uint ;;
		*)                 echo bool ;;
	esac
}

quiet=false

die() {
	echo "nolock: $*" >&2
	exit 1
}

raw() { # container key -> the value, or "unset"
	case $BACKEND in
		niri) python3 "$SETTING" get "$1" "$2" 2>/dev/null || echo unset ;;
		x11)  xfconf-query -c "$1" -p "$2" 2>/dev/null || echo unset ;;
	esac
}

effective() { # table key default -> the value noctalia acts on
	local value
	value=$(raw "$1" "$2")
	if [ "$value" = unset ]; then
		echo "$3"
	else
		echo "$value"
	fi
}

locks() { # table key locking-value default -> 0 if this key would lock
	[ "$(effective "$1" "$2" "$4")" = "$3" ]
}

del_value() { # container key — back to the shipped default
	case $BACKEND in
		niri)
			python3 "$SETTING" del "$1" "$2"
			local now
			now=$(raw "$1" "$2")
			[ "$now" = unset ] || die "$1.$2 still reads $now after being unset"
			;;
		x11)
			# Deliberately NOT --reset here, and this is the one place the two
			# backends genuinely cannot share an implementation.
			# xfce4-power-manager binds its keys both ways, so removing the
			# property makes the daemon write its in-memory copy — still the
			# nolock value — straight back. The failure is silent and points
			# the wrong way, leaving a laptop that no longer locks after nolock
			# was turned off. Writing the locking value explicitly is the same
			# value the default would have given, and it sticks. That works
			# here precisely because of the coincidence noted above: on XFCE
			# the locking value IS the default.
			set_value "$1" "$2" "$3"
			;;
	esac
}

set_value() { # container key value
	case $BACKEND in
		niri) python3 "$SETTING" set "$1" "$2" "$3" ;;
		x11)  xfconf-query -c "$1" -p "$2" --create --type "$(xfconf_type "$2")" --set "$3" >/dev/null ;;
	esac
	# Read back rather than trusting the write: noctalia owns this file and
	# rewrites it whenever a setting changes in its UI, and a restore that
	# half-lands leaves a laptop that doesn't lock while nolock reports itself
	# off. Same argument as the XFCE version's read-back, different owner.
	local now
	now=$(raw "$1" "$2")
	[ "$now" = "$3" ] || die "$1.$2 reads $now after being set to $3"
}

# Tell the running shell to pick the file up. Without this the change is real
# but does not take effect until noctalia is restarted, which is precisely the
# gap that makes a toggle feel broken.
reload() {
	# noctalia keeps its settings in a file it reads at startup, so a write has
	# to be announced. xfconf has no equivalent step: xfconfd is the daemon
	# holding the value, so writing through xfconf-query IS the notification
	# and the bound daemons act on it immediately.
	[ "$BACKEND" = niri ] || return 0
	command -v noctalia >/dev/null 2>&1 || return 0
	noctalia msg config-reload >/dev/null 2>&1 || true
}

state() {
	local table key nolock_value lock_value default
	while IFS=$'\t' read -r table key nolock_value lock_value default; do
		if locks "$table" "$key" "$lock_value" "$default"; then
			echo off
			return
		fi
	done < <(printf '%s\n' "${KEYS[@]}")
	echo on
}

snapshot() {
	# Per key rather than all-or-nothing on the file existing, so a key added
	# to the table above is recorded the first time it is turned off even
	# though the file is already there from an earlier `on`. Keys already
	# recorded are left alone: re-recording would overwrite the originals with
	# the values nolock itself just wrote.
	mkdir -p "$STATE_DIR"
	local table key nolock_value lock_value default
	while IFS=$'\t' read -r table key nolock_value lock_value default; do
		if [ -e "$SAVED" ] && cut -f1,2 "$SAVED" | grep -qxF "$table	$key"; then
			continue
		fi
		printf '%s\t%s\t%s\n' "$table" "$key" "$(raw "$table" "$key")" >>"$SAVED"
	done < <(printf '%s\n' "${KEYS[@]}")
}

enable() {
	snapshot
	local table key nolock_value lock_value default
	while IFS=$'\t' read -r table key nolock_value lock_value default; do
		# Only the keys actually standing in the way, so anything already
		# harmless keeps whatever value it was given.
		if locks "$table" "$key" "$lock_value" "$default"; then
			set_value "$table" "$key" "$nolock_value"
		fi
	done < <(printf '%s\n' "${KEYS[@]}")
	reload
}

disable() {
	local table key nolock_value lock_value default saved
	while IFS=$'\t' read -r table key nolock_value lock_value default; do
		saved=unset
		if [ -e "$SAVED" ]; then
			# Falls through to the locking value when the key isn't in the
			# file — the settings were changed by hand, the state directory was
			# cleared, or the table grew since the snapshot was taken.
			saved=$(awk -F'\t' -v t="$table" -v k="$key" \
				'$1 == t && $2 == k { print $3; exit }' "$SAVED")
			[ -n "$saved" ] || saved=unset
		fi
		if [ "$saved" = unset ]; then
			# The key was not set before nolock touched it, so putting it back
			# means removing it, not writing a value over it.
			#
			# The XFCE version wrote the locking value here instead, and could:
			# for all five of its keys the locking value *was* the shipped
			# default, so the two were the same act. Here they are not.
			# lock_before_suspend defaults to true, so deleting it restores the
			# lock — but both idle behaviours default to false, and writing
			# true over them would arm an idle lock this machine never had.
			# Restoring means restoring, not "make everything lock".
			#
			# The third argument is only read by the X11 branch, which cannot
			# unset a key without the daemon writing it straight back — see
			# del_value. On niri it is ignored.
			del_value "$table" "$key" "$lock_value"
		else
			set_value "$table" "$key" "$saved"
		fi
	done < <(printf '%s\n' "${KEYS[@]}")
	rm -f "$SAVED"
	reload
}

notify() {
	if $quiet; then
		return 0
	fi
	command -v notify-send >/dev/null || return 0
	# The synchronous hint replaces the previous nolock bubble instead of
	# stacking one per toggle.
	local args=(-a nolock -h string:x-canonical-private-synchronous:nolock)
	if [ "$1" = on ]; then
		notify-send "${args[@]}" -i changes-allow-symbolic \
			"Wake login off" "Opening the lid or waking won't ask for your password." || true
	else
		notify-send "${args[@]}" -i changes-prevent-symbolic \
			"Wake login on" "Opening the lid or waking asks for your password again." || true
	fi
}

# What the lid currently does, for `status`. Reported and never changed — see
# the header. Unset means logind's own default, which is suspend.
lid_action() {
	# Under XFCE this is not logind's call at all: xfce4-power-manager holds a
	# handle-lid-switch inhibitor and decides for itself, which is why the lid
	# pair is in the KEYS table above and IS managed there. Under niri nothing
	# takes that inhibitor, so the lid belongs to logind and its setting is
	# root-owned system configuration — reported, never touched.
	if [ "$BACKEND" = x11 ]; then
		printf 'xfce4-power-manager (managed above)\n'
		return
	fi
	local value
	value=$(systemd-analyze cat-config systemd/logind.conf 2>/dev/null \
		| grep -iE '^[[:space:]]*HandleLidSwitch=' | tail -1 | cut -d= -f2)
	printf '%s\n' "${value:-suspend (logind default)}"
}

if [ "$BACKEND" = niri ]; then
	[ -x "$SETTING" ] || die "missing helper: $SETTING"
	command -v python3 >/dev/null || die "python3 not found"
else
	command -v xfconf-query >/dev/null || die "xfconf-query not found"
fi

action=status
for arg in "$@"; do
	case "$arg" in
	-q | --quiet) quiet=true ;;
	status | on | off | toggle) action=$arg ;;
	-h | --help)
		# The header block, however long it grows.
		awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
		exit 0
		;;
	*) die "unknown argument: $arg" ;;
	esac
done

case "$action" in
status)
	now=$(state)
	echo "$now"
	if ! $quiet; then
		if [ "$BACKEND" = x11 ]; then
			echo "  lid close:  $(lid_action)"
		else
			echo "  lid close:  $(lid_action)   (system setting, not managed here)"
		fi
		while IFS=$'\t' read -r table key nolock_value lock_value default; do
			printf '  %-46s %s\n' "$table.$key" "$(effective "$table" "$key" "$default")"
		done < <(printf '%s\n' "${KEYS[@]}")
	fi
	exit 0
	;;
toggle)
	[ "$(state)" = on ] && action=off || action=on
	;;
esac

if [ "$action" = on ]; then enable; else disable; fi

now=$(state)
[ "$now" = "$action" ] || die "wanted $action but the settings read back as $now"
notify "$now"
echo "$now"

# Entry points
# --------------------------------------------------------------------------

def lock_memory():
    """mlockall(MCL_CURRENT | MCL_FUTURE).

    A watchdog that is itself paged out arrives late to exactly the emergency
    it exists for. Needs LimitMEMLOCK=infinity in the unit; systemd's 8 MB
    default is not enough for a Python process.
    """
    try:
        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        if libc.mlockall(1 | 2) != 0:
            err = ctypes.get_errno()
            log(f"mlockall failed ({os.strerror(err)}) — running unlocked")
    except OSError as exc:
        log(f"mlockall unavailable: {exc}")


def print_status(cfg):
    mem = read_meminfo()
    psi = read_psi_full_avg10()
    print(f"memory   {mem.avail / 1024:7.0f} MB free of {mem.total / 1024:.0f} MB"
          f"   ({mem.mem_pct:.1f}%)")
    print(f"swap     {mem.swap_free / 1024:7.0f} MB free of "
          f"{mem.swap_total / 1024:.0f} MB   ({mem.swap_pct:.1f}%)")
    print(f"pressure {psi:7.1f}   (memory PSI full avg10)")
    print()
    print(f"freeze at mem <= {cfg['freeze_mem_pct']:.0f}% and swap <= "
          f"{cfg['freeze_swap_pct']:.0f}%, or PSI >= {cfg['freeze_psi']:.0f} for "
          f"{cfg['freeze_psi_secs']:.0f}s")
    print(f"kill   at mem <= {cfg['kill_mem_pct']:.0f}% and swap <= "
          f"{cfg['kill_swap_pct']:.0f}%, or PSI >= {cfg['kill_psi']:.0f} for "
          f"{cfg['kill_psi_secs']:.0f}s")
    print()

    # Two sweeps with a gap between them: growth and CPU are rates, and one
    # sample cannot show a rate. Without this the whole table would read 0.
    protect = protected_names(cfg)
    attention = Attention(cfg)
    tracker = Tracker()
    sized, ppid_of, comm_of = scan_processes()
    attention.refresh(time.monotonic(), ppid_of, comm_of, protect)
    rank_victims(sized, mem, protect, cfg, attention, tracker, time.monotonic())
    time.sleep(0.6)
    now = time.monotonic()
    sized, ppid_of, comm_of = scan_processes()
    attention.refresh(now, ppid_of, comm_of, protect)
    victims = rank_victims(sized, mem, protect, cfg, attention, tracker, now)

    if not cfg["focus_aware"]:
        print("focus    ignored (focus_aware = 0) — ranking by size alone")
    elif attention.pid:
        print(f"focus    {comm_of.get(attention.pid, '?')} [{attention.pid}] "
              f"and {max(0, len(attention.group) - 1)} process(es) behind it")
    else:
        print("focus    unknown (no graphical session, or nothing is "
              "focused) — ranking by size alone")
    print()

    print(f"next in line (under {cfg['min_victim_mb']:.0f} MB is never touched; "
          f"score is projected share of RAM per mille + oom_score_adj):")
    for victim in victims[:10]:
        mark = "  " if victim.tier == 0 else "~ " if victim.tier == 1 else "* "
        print(f"  {mark}{victim.points:6.0f}  {victim.kb / 1024:7.0f} MB  "
              f"{victim.cpu:4.0f}% cpu  {victim.growth / 1024:+6.1f} MB/s  "
              f"{'in use' if victim.busy else '  idle'}  "
              f"{victim.name} [{victim.pid}]")
    if not victims:
        print("  (nothing eligible — everything big enough is protected)")
    else:
        print()
        print("  ~ belongs to the focused app   * is the focused window itself")
        print("  Both are reached only once everything above them is exhausted.")


def main():
    args = sys.argv[1:]
    cfg = load_config()

    if "--help" in args or "-h" in args:
        print(__doc__)
        return 0

    if "--status" in args:
        print_status(cfg)
        return 0

    if "--test-notify" in args:
        if os.geteuid() != 0:
            print("--test-notify has to run as root, the way the service does",
                  file=sys.stderr)
            return 1
        notify("OOM Defender is watching",
               "This is a test. If you can read it, the defender can reach you "
               "when it matters.")
        time.sleep(1)  # let the forked notify-send finish before we exit
        return 0

    dry_run = "--dry-run" in args
    for arg in args:
        if arg not in ("--dry-run",):
            print(f"unknown argument: {arg}", file=sys.stderr)
            return 1

    # Dry runs signal nothing, so they are worth being able to watch as
    # yourself; a real run has to reach other users' processes.
    if os.geteuid() != 0 and not dry_run:
        print("oom-defender must run as root — it signals other users' processes",
              file=sys.stderr)
        return 1

    # Belt and braces: the unit sets this too, but running it by hand should
    # not put the watchdog first in line to be killed.
    try:
        with open("/proc/self/oom_score_adj", "w") as fh:
            fh.write("-1000")
    except OSError as exc:
        log(f"could not set own oom_score_adj: {exc}")

    lock_memory()

    defender = Defender(cfg, dry_run=dry_run)
    signal.signal(signal.SIGTERM, defender.shutdown)
    signal.signal(signal.SIGINT, defender.shutdown)
    signal.signal(signal.SIGHUP,
                  lambda *_: setattr(defender, "reload_requested", True))
    # We never wait on the notify-send children; let the kernel reap them.
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)

    defender.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())

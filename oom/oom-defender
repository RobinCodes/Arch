# Notifications
# --------------------------------------------------------------------------

_session = None  # (uid, gid, username, env) of the graphical session, cached

# Session owners, best first. Any of them carries the environment we need; the
# ordering just prefers the process least likely to be a transient child.
#
# niri first, because on this machine it is the session and the XFCE names
# below no longer exist. They are kept because nothing about this daemon is
# specific to either desktop, and a session it does not recognise costs it
# both notifications and focus — the two things it most needs to be right
# about when it is deciding what to kill.
_SESSION_OWNERS = ("niri", "niri-session", "noctalia",
                   "xfce4-session", "xfsettingsd", "xfce4-panel", "xfdesktop",
                   "xfwm4", "xfconfd", "dbus-daemon")
# WAYLAND_DISPLAY and NIRI_SOCKET join DISPLAY here for the same reason: this
# is the set of variables that has to be carried from the session into a root
# process so it can talk back to that session.
_SESSION_ENV = ("DISPLAY", "WAYLAND_DISPLAY", "NIRI_SOCKET",
                "DBUS_SESSION_BUS_ADDRESS", "XAUTHORITY",
                "XDG_RUNTIME_DIR", "HOME", "USER", "LANG", "PATH")


def find_session(force=False):
    """Locate a logged-in graphical session to send notifications into.

    We run as root outside any session, so notify-send needs to be handed the
    user's DISPLAY and session bus and then dropped to their uid. Everything
    needed for that is sitting in the environment of any process the session
    started.
    """
    global _session
    if _session and not force:
        return _session

    best = None
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            st = os.stat(f"/proc/{pid}")
            if st.st_uid == 0:
                continue
            with open(f"/proc/{pid}/comm") as fh:
                comm = fh.read().strip()
            if comm not in _SESSION_OWNERS:
                continue
            with open(f"/proc/{pid}/environ", "rb") as fh:
                raw = fh.read()
        except OSError:
            continue

        env = {}
        for item in raw.split(b"\0"):
            key, sep, value = item.partition(b"=")
            if sep:
                key = key.decode("utf-8", "replace")
                if key in _SESSION_ENV:
                    env[key] = value.decode("utf-8", "replace")
        # Either display protocol will do. Requiring DISPLAY specifically was
        # what made this return None outright under a Wayland session, which
        # cost the notifications as well as the focus.
        if "DBUS_SESSION_BUS_ADDRESS" not in env:
            continue
        if "DISPLAY" not in env and "WAYLAND_DISPLAY" not in env:
            continue

        rank = _SESSION_OWNERS.index(comm)
        if best is None or rank < best[0]:
            try:
                pw = pwd.getpwuid(st.st_uid)
            except KeyError:
                continue
            env.setdefault("HOME", pw.pw_dir)
            env.setdefault("USER", pw.pw_name)
            env.setdefault("PATH", "/usr/local/bin:/usr/bin")
            best = (rank, st.st_uid, st.st_gid, pw.pw_name, env)

    _session = best[1:] if best else None
    return _session


def notify(summary, body, critical=False):
    """Fire a desktop notification, without ever blocking the main loop.

    fork+execve rather than subprocess: the child does no allocation between
    fork and exec, which is what you want from code that runs exactly when the
    machine has no memory to hand out.
    """
    log(f"notify: {summary} — {body}")
    session = find_session()
    if session is None:
        session = find_session(force=True)
        if session is None:
            log("notify: no graphical session found; journal only")
            return

    uid, gid, username, env = session
    argv = [
        NOTIFY_SEND,
        "--app-name=OOM Defender",
        "--icon=" + ("dialog-error" if critical else "dialog-warning"),
        "--urgency=" + ("critical" if critical else "normal"),
        "--expire-time=" + ("0" if critical else "12000"),
        # Collapse repeats onto one bubble instead of stacking a wall of them.
        "--hint=string:x-canonical-private-synchronous:oom-defender",
        summary,
        body,
    ]

    try:
        pid = os.fork()
    except OSError as exc:
        log(f"notify: fork failed: {exc}")
        return
    if pid == 0:
        try:
            os.setgid(gid)
            os.initgroups(username, gid)
            os.setuid(uid)
            os.execve(NOTIFY_SEND, argv, env)
        except BaseException:
            pass
        os._exit(127)



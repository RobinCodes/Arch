#!/usr/bin/env python3
"""OOM Defender — stop the memory hog before it stops the machine.

On a 3.4 GB laptop the kernel's own OOM killer is too late to be much use: by
the time it fires, the machine has already spent half a minute thrashing and
the desktop stopped repainting. This daemon watches memory itself and acts
while there is still room to act in.

Two tiers, because the cheap response should come first:

  freeze  The biggest memory hog gets SIGSTOP. It stops executing, so it stops
          allocating, and the kernel gets to reclaim without racing a process
          that is still growing. Nothing is lost — if memory recovers the
          process is resumed with SIGCONT and the whole episode cost a stutter.

  kill    If freezing bought no recovery within `freeze_grace` seconds, or if
          memory falls off a cliff outright, the hog gets SIGKILL. The victim
          is re-picked at that moment rather than inherited from the freeze:
          the process worth freezing 20 seconds ago is not always the one
          holding the machine down now.

Both tiers raise a desktop notification. A process that silently freezes or
vanishes is worse than one you were told about, and "the defender had to step
in" is exactly the thing you want to know before you go looking for the tab
that disappeared.

WHO GETS PICKED. The biggest process is the wrong answer. If you are watching
a video with twenty idle tabs behind it, the video is very likely the largest
thing on the machine, and freezing it to save the tabs nobody is looking at
gets the trade exactly backwards. Candidates are therefore ordered by three
keys, in this order:

  attention  Whether the process belongs to the window you are focused on.
             The focused window's PID comes from the window manager; the group
             around it is grown down through its children and up through its
             parents, stopping at the first protected process. That is what
             keeps a browser's content children with the browser without the
             walk escaping into xfce4-session and protecting the whole desktop.
  in use     Within a group, something burning CPU without growing is doing
             work you can see or hear. Something burning CPU *and* growing is
             the runaway, and stays a candidate.
  size       Projected a few seconds forward rather than measured now, so a
             process allocating 40 MB/s outranks one that has been sitting on
             400 MB all afternoon.

The result is that the first thing frozen is the biggest idle process you are
not looking at, and the app in front of you is reached only when nothing else
is left. Freezing is also allowed to happen more than once: several idle
processes suspended in sequence is a gentler way out than one big kill.

Killing orders the same candidates differently, because the two acts cost
different things. A freeze is reversible and costs a stutter, so it should
always be spent on something you are not using, however small. A kill throws
work away, so it has to be spent on something big enough to actually end the
episode — there is no sense destroying a 400 MB background job to rescue a
machine being held down by a 2 GB one. Focus is therefore a bias when killing
rather than an absolute: a process belonging to the app you are in is passed
over while something unfocused is within reach of the same size, and chosen
once nothing else can plausibly help.

TRIGGERS. Two independent paths, because with a large swapfile the two ways a
machine dies look nothing alike:

  exhaustion  Free memory *and* free swap are both nearly gone. The classic
              earlyoom condition — a genuine allocation wall is coming.
  thrashing   The memory PSI "full" figure stays high — every task is stalled
              waiting on paging. Plenty of swap may remain; the machine is
              still unusable, and with 19 GB of swap this is how you actually
              lose an afternoon.

SAFETY. Nothing in `protect` is ever a victim, nor is anything with an
oom_score_adj at or below -900 (which includes this daemon). Victims are
identified by PID *and* start time, so a recycled PID can never be signalled by
mistake. Every frozen process is resumed if the daemon exits for any reason —
a leftover SIGSTOP would look exactly like a hung app.

Config lives in /etc/oom-defender.conf (key = value, '#' comments); SIGHUP
reloads it. Run with --status to see where you stand right now, --dry-run to
watch it decide without signalling anything, --test-notify to check the
notification path reaches your desktop.
"""

import ctypes
import os
import pwd
import select
import signal
import sys
import time

CONFIG_PATH = "/etc/oom-defender.conf"

# Percentages are of MemTotal / SwapTotal; seconds are seconds.
DEFAULTS = {
    # Tier 1 — freeze. Both conditions must hold for the exhaustion path.
    "freeze_mem_pct": 10.0,
    "freeze_swap_pct": 25.0,
    # Tier 2 — kill.
    "kill_mem_pct": 5.0,
    "kill_swap_pct": 12.0,
    # The thrashing path: memory PSI "full avg10", held for this many seconds.
    # avg10 is already a 10-second average, so the hold is a second filter
    # against a single burst of paging (opening a big file, waking from idle).
    "freeze_psi": 15.0,
    "freeze_psi_secs": 10.0,
    "kill_psi": 40.0,
    "kill_psi_secs": 20.0,
    # Resume frozen processes once memory is back above this and paging has
    # calmed down. Deliberately well above freeze_mem_pct: releasing at the
    # threshold we froze at just re-freezes a second later.
    "release_mem_pct": 20.0,
    # How long a freeze is given to produce a recovery before we escalate.
    "freeze_grace": 20.0,
    # A freeze is meant to be a stutter, not a sentence. Memory here can sit
    # between freeze_mem_pct and release_mem_pct for a very long time — on
    # 2026-08-11 that gap kept a browser process suspended for eleven minutes,
    # because nothing was firing any more but nothing had recovered enough to
    # release it either. Past this many seconds, with nothing currently
    # triggering, let it go: a second stutter later costs far less than a hang
    # the user is sitting in front of.
    "freeze_max_secs": 90.0,
    # After a kill, don't kill again for this long. PSI averages lag reality by
    # several seconds, so without this one runaway costs you three processes.
    "kill_cooldown": 10.0,
    # Prefer victims outside the focused window's process group. 0 turns the
    # whole idea off and ranks purely by size, the way this started out.
    "focus_aware": 1,
    # How often to ask the window manager what is focused. Focus does not
    # change on the timescale that matters here, and the answer is cached, so
    # this is cheap even at the tightest polling interval.
    "focus_poll": 2.0,
    # Freezing one process rarely ends an episode on its own. Up to this many
    # may be suspended, one every freeze_interval seconds, before the grace
    # period runs out and something gets killed instead.
    "max_frozen": 4.0,
    "freeze_interval": 3.0,
    # Rank on the size a process is heading for, this many seconds ahead, so a
    # runaway is picked while it is still small enough to be worth freezing.
    "growth_lookahead": 10.0,
    # Growing faster than this (kB/s) means "still allocating", which keeps a
    # busy process a candidate instead of reading as in-use.
    "growth_min_kb": 512.0,
    # CPU percent (of one core) above which a process counts as in use.
    "busy_cpu_pct": 8.0,
    # How much bigger a process belonging to the focused app has to be before
    # it is killed in preference to something you are not using. 3 means four
    # times the size; 0 removes the protection at the kill tier entirely.
    "kill_focus_bias": 3.0,
    # Minimum gap between full /proc sweeps. The tick rate rises to 10 Hz under
    # pressure; re-walking every process that often would make the watchdog a
    # noticeable load in its own right, and rates need a window to be measured
    # over anyway.
    "scan_interval": 0.5,
    # Never touch a process smaller than this, whatever it scores. Two dozen
    # D-Bus session services on this box ship with oom_score_adj=200 while
    # being 3-8 MB each, which the kernel's own formula ranks above a 500 MB
    # browser. Freeing 5 MB does not end an OOM; it just breaks the trash icon
    # and leaves the actual hog running.
    "min_victim_mb": 96.0,
    # comm names, comma separated. Compared on the first 15 characters because
    # that is all the kernel keeps, so long names match without being spelled
    # out in their truncated form.
    "protect": (
        "systemd,systemd-journald,systemd-logind,systemd-udevd,systemd-resolved,"
        "systemd-timesyncd,systemd-userdbd,systemd-oomd,init,"
        "dbus-broker,dbus-broker-launch,dbus-daemon,polkitd,accounts-daemon,"
        "NetworkManager,wpa_supplicant,bluetoothd,sshd,agetty,login,"
        "Xorg,lightdm,xfce4-session,xfwm4,xfsettingsd,xfce4-panel,xfdesktop,"
        "xfconfd,xfce4-notifyd,xfce4-power-manager,"
        "pipewire,pipewire-pulse,wireplumber,pulseaudio,upowerd,udisksd,"
        "oom-defender"
    ),
    "dry_run": 0,
}

NOTIFY_SEND = "/usr/bin/notify-send"
XPROP = "/usr/bin/xprop"
NIRI = "/usr/bin/niri"
PAGE_KB = os.sysconf("SC_PAGE_SIZE") // 1024
CLOCK_TICKS = os.sysconf("SC_CLK_TCK")


def log(msg):
    """Journal, via stdout — systemd captures it."""
    sys.stdout.write(msg + "\n")
    sys.stdout.flush()


# --------------------------------------------------------------------------
# Config
# --------------------------------------------------------------------------

def load_config(path=CONFIG_PATH):
    cfg = dict(DEFAULTS)
    try:
        with open(path) as fh:
            lines = fh.readlines()
    except FileNotFoundError:
        return cfg
    except OSError as exc:
        log(f"config: cannot read {path}: {exc} — using defaults")
        return cfg

    for n, raw in enumerate(lines, 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if "=" not in line:
            log(f"config: {path}:{n}: no '=', ignored")
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if key not in DEFAULTS:
            log(f"config: {path}:{n}: unknown key {key!r}, ignored")
            continue
        if isinstance(DEFAULTS[key], str):
            cfg[key] = value
        else:
            try:
                cfg[key] = float(value)
            except ValueError:
                log(f"config: {path}:{n}: {key} wants a number, got {value!r}")
    return cfg


def protected_names(cfg):
    # The kernel truncates comm to 15 characters (TASK_COMM_LEN - 1), so both
    # sides get truncated and long names in the config still match.
    return {name.strip()[:15] for name in cfg["protect"].split(",") if name.strip()}



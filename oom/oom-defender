# The defender
# --------------------------------------------------------------------------

class Defender:
    def __init__(self, cfg, dry_run=False):
        self.cfg = cfg
        self.protect = protected_names(cfg)
        self.dry_run = dry_run or bool(cfg["dry_run"])
        self.frozen = []          # Victims currently under SIGSTOP
        self.freeze_psi_since = None
        self.kill_psi_since = None
        self.kill_cooldown_until = 0.0
        self.last_freeze = 0.0
        self.reload_requested = False
        self.running = True
        self.attention = Attention(cfg)
        self.tracker = Tracker()
        self.ranked = []
        self.ranked_at = 0.0

    def candidates(self, mem, now):
        """The ordered victim list, refreshed at most every scan_interval.

        Called on every tick rather than only when acting, because growth and
        CPU are rates: asking for them the instant an emergency starts would
        get zeroes back, and the whole point is to know which process has been
        the one growing.
        """
        if self.ranked and now - self.ranked_at < self.cfg["scan_interval"]:
            return self.ranked
        sized, ppid_of, comm_of = scan_processes()
        self.attention.refresh(now, ppid_of, comm_of, self.protect)
        self.ranked = rank_victims(sized, mem, self.protect, self.cfg,
                                   self.attention, self.tracker, now)
        self.ranked_at = now
        return self.ranked

    # -- signalling ------------------------------------------------------

    def _signal(self, victim, sig, what):
        if not victim.alive():
            return False
        if self.dry_run:
            log(f"[dry-run] would {what} {victim}")
            return True
        try:
            os.kill(victim.pid, sig)
        except ProcessLookupError:
            return False
        except PermissionError as exc:
            log(f"cannot {what} {victim}: {exc}")
            return False
        return True

    def freeze(self, victim, mem, psi):
        if not self._signal(victim, signal.SIGSTOP, "freeze"):
            return
        victim.frozen_at = self.last_freeze = time.monotonic()
        self.frozen.append(victim)
        log(f"FREEZE {victim} tier {victim.tier} cpu {victim.cpu:.0f}% "
            f"growth {victim.growth / 1024:+.1f} MB/s at mem {mem.mem_pct:.1f}% "
            f"swap {mem.swap_pct:.1f}% psi {psi:.0f}")
        others = len(self.frozen) - 1
        notify(
            f"Frozen: {victim.name}",
            f"Memory was down to {mem.mem_pct:.0f}% free, so OOM Defender "
            f"suspended {victim.name} (PID {victim.pid}, {victim.kb / 1024:.0f} MB) "
            f"to stop it allocating — {victim.why()}. It resumes automatically "
            f"once memory recovers, or is killed in "
            f"{self.cfg['freeze_grace']:.0f}s if it doesn't."
            + (f" {others} other process(es) already suspended." if others else ""),
        )

    def release(self, reason):
        for victim in self.frozen:
            if self._signal(victim, signal.SIGCONT, "resume"):
                log(f"RESUME {victim} ({reason})")
        if self.frozen and not self.dry_run:
            names = ", ".join(v.name for v in self.frozen)
            notify(f"Resumed: {names}", f"Memory recovered — {reason}.")
        self.frozen = []

    def kill(self, victim, mem, psi, reason):
        before = mem.avail
        # A SIGSTOPped process still dies on SIGKILL; no SIGCONT needed first.
        if not self._signal(victim, signal.SIGKILL, "kill"):
            return
        log(f"KILL {victim} at mem {mem.mem_pct:.1f}% swap {mem.swap_pct:.1f}% "
            f"psi {psi:.0f} ({reason})")

        # Wait briefly for the memory to actually come back, so the
        # notification can say how much the kill bought.
        freed = 0
        if not self.dry_run:
            deadline = time.monotonic() + 3.0
            while time.monotonic() < deadline:
                if not victim.alive():
                    freed = max(0, read_meminfo().avail - before)
                    break
                time.sleep(0.05)

        self.frozen = [v for v in self.frozen if v.pid != victim.pid]
        notify(
            f"Killed: {victim.name}",
            f"OOM Defender killed {victim.name} (PID {victim.pid}, "
            f"{victim.kb / 1024:.0f} MB) to keep the system responsive — "
            f"{reason}, and {victim.why()}. "
            + (f"{freed / 1024:.0f} MB came back." if freed else ""),
            critical=True,
        )
        self.kill_cooldown_until = time.monotonic() + self.cfg["kill_cooldown"]
        # PSI is a trailing average and will still read high for several
        # seconds after the cause is gone. Forget what we saw.
        self.freeze_psi_since = self.kill_psi_since = None
        self.release("the hog is gone")

    # -- the loop --------------------------------------------------------

    def sustained(self, since, psi, threshold, seconds, now):
        """Track how long PSI has sat above a threshold. Returns (since, fired)."""
        if psi < threshold:
            return None, False
        if since is None:
            since = now
        return since, (now - since) >= seconds

    def tick(self):
        cfg = self.cfg
        now = time.monotonic()
        mem = read_meminfo()
        psi = read_psi_full_avg10()

        self.freeze_psi_since, thrash_freeze = self.sustained(
            self.freeze_psi_since, psi, cfg["freeze_psi"], cfg["freeze_psi_secs"], now)
        self.kill_psi_since, thrash_kill = self.sustained(
            self.kill_psi_since, psi, cfg["kill_psi"], cfg["kill_psi_secs"], now)

        starved_kill = (mem.mem_pct <= cfg["kill_mem_pct"]
                        and mem.swap_pct <= cfg["kill_swap_pct"])
        starved_freeze = (mem.mem_pct <= cfg["freeze_mem_pct"]
                          and mem.swap_pct <= cfg["freeze_swap_pct"])

        # Drop anything that died while frozen — its memory is already back.
        self.frozen = [v for v in self.frozen if v.alive()]

        # Freezing buys time, it does not free a byte. If the grace period
        # passed and we are still in trouble, the freeze failed and something
        # has to go.
        stale = (self.frozen and (starved_freeze or thrash_freeze)
                 and now - self.frozen[0].frozen_at >= cfg["freeze_grace"])

        # Kept warm on every tick: growth and CPU are rates, and a list first
        # built at the moment of the emergency knows neither.
        victims = self.candidates(mem, now)

        if (starved_kill or thrash_kill or stale) and now >= self.kill_cooldown_until:
            reason = ("free memory exhausted" if starved_kill
                      else "the system was thrashing" if thrash_kill
                      else "freezing it did not free enough")
            # Re-pick rather than inherit the frozen victim: over 20 seconds
            # the process holding the machine down may well have changed.
            ranked = kill_order(victims, self.cfg)
            if ranked:
                self.kill(ranked[0], mem, psi, reason)
            else:
                log("nothing eligible to kill — everything big enough is protected")
            return mem

        if (starved_freeze or thrash_freeze) \
                and len(self.frozen) < self.cfg["max_frozen"] \
                and now - self.last_freeze >= self.cfg["freeze_interval"]:
            # One more idle process per interval rather than one per episode.
            # Suspending four things nobody is looking at is a far gentler way
            # out of this than killing the one biggest thing, and each freeze
            # gets an interval to show whether it was enough.
            already = {v.pid for v in self.frozen}
            for victim in victims:
                if victim.pid not in already:
                    self.freeze(victim, mem, psi)
                    break
            else:
                log("nothing left to freeze — everything big enough is "
                    "protected or already suspended")
            return mem

        if self.frozen and mem.mem_pct >= cfg["release_mem_pct"] \
                and psi <= cfg["freeze_psi"] / 2:
            self.release(f"{mem.mem_pct:.0f}% free")
        elif self.frozen and not (starved_freeze or thrash_freeze) \
                and now - self.frozen[0].frozen_at >= cfg["freeze_max_secs"]:
            # Nothing is firing any more, but memory never climbed back to
            # release_mem_pct either — the gap this machine spends most of its
            # life in. Waiting for a full recovery that may not come is how a
            # freeze turns into an eleven-minute hang.
            self.release(f"held {cfg['freeze_max_secs']:.0f}s with nothing "
                         f"still firing")

        return mem

    def run(self):
        log(f"OOM Defender watching: freeze below {self.cfg['freeze_mem_pct']:.0f}% "
            f"free memory, kill below {self.cfg['kill_mem_pct']:.0f}%"
            + (" [DRY RUN]" if self.dry_run else ""))
        while self.running:
            if self.reload_requested:
                self.reload_requested = False
                self.cfg = load_config()
                self.protect = protected_names(self.cfg)
                log("config reloaded")
            try:
                mem = self.tick()
            except Exception as exc:  # never let one bad read end the watch
                log(f"tick failed: {exc!r}")
                time.sleep(1.0)
                continue
            # Poll harder the closer we get; one small read costs nothing, and
            # a runaway allocator can cross the last 10% in well under a second.
            pct = mem.mem_pct
            time.sleep(1.0 if pct > 30 else 0.5 if pct > 20
                       else 0.2 if pct > 12 else 0.1)

    def shutdown(self, signum, _frame):
        # A process left under SIGSTOP is indistinguishable from a hung one.
        # Whatever happens to us, it gets to run again.
        self.running = False
        log(f"signal {signum} — releasing {len(self.frozen)} frozen process(es)")
        for victim in self.frozen:
            self._signal(victim, signal.SIGCONT, "resume")
        self.frozen = []
        sys.exit(0)



class Mem:
    __slots__ = ("total", "avail", "swap_total", "swap_free")

    @property
    def mem_pct(self):
        return 100.0 * self.avail / self.total if self.total else 100.0

    @property
    def swap_pct(self):
        # No swap at all is not "0% free" — it is "swap is not the problem".
        return 100.0 * self.swap_free / self.swap_total if self.swap_total else 100.0


def read_meminfo():
    m = Mem()
    m.total = m.avail = m.swap_total = m.swap_free = 0
    with open("/proc/meminfo") as fh:
        for line in fh:
            key, _, rest = line.partition(":")
            if key == "MemTotal":
                m.total = int(rest.split()[0])
            elif key == "MemAvailable":
                m.avail = int(rest.split()[0])
            elif key == "SwapTotal":
                m.swap_total = int(rest.split()[0])
            elif key == "SwapFree":
                m.swap_free = int(rest.split()[0])
                break  # SwapFree is the last field we need
    return m


_psi_warned = False


def read_psi_full_avg10():
    """Percent of the last 10s in which *every* task was stalled on memory."""
    global _psi_warned
    try:
        with open("/proc/pressure/memory") as fh:
            for line in fh:
                if line.startswith("full"):
                    for field in line.split()[1:]:
                        if field.startswith("avg10="):
                            return float(field[6:])
    except OSError:
        if not _psi_warned:
            _psi_warned = True
            log("PSI unavailable (/proc/pressure/memory) — thrash detection off, "
                "exhaustion thresholds still apply")
    return 0.0


class Victim:
    __slots__ = ("pid", "name", "kb", "points", "start", "frozen_at",
                 "tier", "busy", "growth", "cpu")

    def __init__(self, pid, name, kb, points, start):
        self.pid = pid
        self.name = name
        self.kb = kb
        self.points = points
        self.start = start
        self.frozen_at = 0.0
        self.tier = 0      # 0 unfocused, 1 focused app's group, 2 the window itself
        self.busy = 0      # 1 when it looks like it is doing work for you
        self.growth = 0.0  # kB/s
        self.cpu = 0.0     # percent of one core

    def __str__(self):
        return f"{self.name}[{self.pid}] {self.kb / 1024:.0f} MB"

    def why(self):
        """The one-line reason this was the process picked."""
        if self.tier == 2:
            return "it is the window in front of you and nothing else was left"
        if self.tier == 1:
            return "it belongs to the app you are using, but nothing else was left"
        if self.growth > 0:
            return f"it is idle, unfocused and still growing ({self.growth / 1024:.0f} MB/s)"
        return "it is the largest thing you are not using"

    def alive(self):
        """Still the same process, and still holding memory.

        A zombie counts as dead here: its pages are already gone, only the
        exit status is left. Treating one as alive would leave a corpse in the
        frozen list and make the post-kill wait sit out its full timeout while
        the machine is still short of memory.
        """
        state, start, _ = read_stat_identity(self.pid)
        return start == self.start and state != "Z"


def read_stat_identity(pid):
    """(state, start time, cpu ticks) from /proc/pid/stat.

    Start time is what makes a victim identifiable: PIDs get recycled, and a
    stale one plus a SIGKILL is how a watchdog kills the wrong process. comm
    sits in field 2 and may contain spaces and parentheses, so the split has
    to start after the last ')' — which also means every index below is the
    documented field number minus three.
    """
    try:
        with open(f"/proc/{pid}/stat") as fh:
            data = fh.read()
    except OSError:
        return None, None, 0
    close = data.rfind(")")
    if close < 0:
        return None, None, 0
    fields = data[close + 2:].split()
    try:
        # state (3), starttime (22), utime + stime (14, 15)
        return fields[0], fields[19], int(fields[11]) + int(fields[12])
    except (IndexError, ValueError):
        return None, None, 0


def read_starttime(pid):
    return read_stat_identity(pid)[1]


class Tracker:
    """How each process is changing, sampled from one sweep to the next.

    Size alone cannot tell a runaway from a large well-behaved program, and it
    cannot tell a video decoding from a tab that has been parked all morning.
    Two rates do: kB gained per second, and CPU burned per second.
    """

    __slots__ = ("prev",)

    def __init__(self):
        self.prev = {}  # (pid, start) -> (when, kb, ticks, growth, cpu)

    def update(self, key, now, kb, ticks):
        last = self.prev.get(key)
        if last is None:
            self.prev[key] = (now, kb, ticks, 0.0, 0.0)
            return 0.0, 0.0
        dt = now - last[0]
        if dt < 0.5:
            # Too short a window to divide by; keep the previous answer rather
            # than manufacture a noisy one.
            return last[3], last[4]
        growth = (kb - last[1]) / dt
        cpu = 100.0 * (ticks - last[2]) / (CLOCK_TICKS * dt)
        self.prev[key] = (now, kb, ticks, growth, cpu)
        return growth, cpu

    def prune(self, live):
        if len(self.prev) > len(live):
            for key in [k for k in self.prev if k not in live]:
                del self.prev[key]


def scan_processes():
    """One walk over /proc.

    Returns (sized, ppid_of, comm_of). `sized` carries only processes with
    resident memory, which is what can be a victim; the two maps cover every
    process, because the parent of the window you are looking at may itself be
    tiny and still matter for working out which app it belongs to.
    """
    sized = []
    ppid_of = {}
    comm_of = {}
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        if pid <= 1:
            continue
        comm = None
        ppid = 0
        rss = swap = 0
        try:
            with open(f"/proc/{pid}/status") as fh:
                for line in fh:
                    key, _, rest = line.partition(":")
                    if key == "Name":
                        comm = rest.strip()
                    elif key == "PPid":
                        ppid = int(rest)
                    elif key == "VmRSS":
                        rss = int(rest.split()[0])
                    elif key == "VmSwap":
                        swap = int(rest.split()[0])
                        break  # VmSwap is the last field we need
        except (OSError, ValueError):
            continue  # exited mid-read; nothing to protect it from any more
        if comm is None:
            continue
        comm_of[pid] = comm
        ppid_of[pid] = ppid
        if rss:  # kernel threads have none, and are not ours to signal
            sized.append((pid, comm, rss + swap))
    return sized, ppid_of, comm_of


def rank_victims(sized, mem, protect, cfg, attention, tracker, now):
    """Every eligible process, worst first.

    Size follows the kernel's own badness — resident plus swapped pages as a
    share of RAM, with oom_score_adj added on the same 0..1000 scale, so the
    usual `choom` tuning still applies — but it is only the last of three sort
    keys. Attention comes first and being visibly in use comes second, because
    the largest process and the one worth freezing are usually not the same
    process. See min_victim_mb for why the size floor is not optional.
    """
    min_victim_kb = cfg["min_victim_mb"] * 1024
    lookahead = cfg["growth_lookahead"]
    growth_min = cfg["growth_min_kb"]
    busy_pct = cfg["busy_cpu_pct"]

    victims = []
    live = set()
    for pid, comm, kb in sized:
        if comm[:15] in protect or kb < min_victim_kb:
            continue
        try:
            with open(f"/proc/{pid}/oom_score_adj") as fh:
                adj = int(fh.read())
        except (OSError, ValueError):
            continue
        if adj <= -900:
            continue  # opted out, and that includes us
        state, start, ticks = read_stat_identity(pid)
        if start is None or state == "Z":
            continue

        key = (pid, start)
        live.add(key)
        growth, cpu = tracker.update(key, now, kb, ticks)

        # Score the size it is heading for rather than the size it has. A
        # process taking 40 MB/s is the reason the machine is in trouble; one
        # that has held 400 MB since this morning is merely large, and freezing
        # it buys nothing that was not already bought.
        projected = kb + max(0.0, growth) * lookahead
        victim = Victim(pid, comm, kb, 1000.0 * projected / mem.total + adj, start)
        victim.growth = growth
        victim.cpu = cpu
        victim.tier = (2 if pid == attention.pid
                       else 1 if pid in attention.group
                       else 0)
        # Burning CPU without growing is what being used looks like: a video
        # decoding, a build running, music playing. Burning CPU *and* growing
        # is the runaway itself, which is precisely what we came for.
        victim.busy = 1 if cpu >= busy_pct and growth <= growth_min else 0
        victims.append(victim)

    tracker.prune(live)
    victims.sort(key=lambda v: (v.tier, v.busy, -v.points))
    return victims


def kill_order(victims, cfg):
    """The same candidates, ordered for a kill rather than for a freeze.

    Freezing is reversible, so it is always worth spending on something the
    user is not using, however small it is. Killing is not, so it has to land
    on something big enough to end the episode — freeing 400 MB from a
    background job does nothing for a machine being held down by 2 GB
    somewhere else, and the background job is gone either way. Focus becomes a
    bias here instead of an absolute: with the default of 3, a process in the
    focused app has to be four times the size before it is preferred.
    """
    bias = cfg["kill_focus_bias"]
    return sorted(victims, key=lambda v: -v.points / (1.0 + bias * v.tier))


# --------------------------------------------------------------------------
# What the user is looking at
# --------------------------------------------------------------------------

def run_capture(argv, env, timeout=2.0, limit=4096):
    """Run a command and return its stdout, without ever stalling the loop.

    Not subprocess: the main loop leaves SIGCHLD as SIG_IGN so notify-send
    children are reaped by the kernel, which is exactly the arrangement that
    makes subprocess's own wait() unreliable. We want the output and nothing
    else, so a pipe is the whole requirement.

    The child arms alarm(), which survives execve, rather than the parent
    killing it on timeout. That matters: after SIG_IGN reaping, a pid we time
    out on may already have exited and been replaced, and signalling a
    recycled pid is the one mistake this daemon is built not to make. A child
    that puts itself down cannot be confused with anybody else.
    """
    try:
        read_fd, write_fd = os.pipe()
    except OSError:
        return None
    try:
        pid = os.fork()
    except OSError:
        os.close(read_fd)
        os.close(write_fd)
        return None

    if pid == 0:
        try:
            # Close the read end before any dup2, so a pipe that happened to
            # land on fd 0 cannot be closed again after being replaced.
            os.close(read_fd)
            null = os.open(os.devnull, os.O_RDWR)
            os.dup2(null, 0)
            os.dup2(write_fd, 1)
            os.dup2(null, 2)
            signal.alarm(int(timeout) + 1)
            os.execve(argv[0], argv, env)
        except BaseException:
            pass
        os._exit(127)

    os.close(write_fd)
    chunks = []
    size = 0
    deadline = time.monotonic() + timeout
    try:
        while size < limit:
            left = deadline - time.monotonic()
            if left <= 0:
                break
            if not select.select([read_fd], [], [], left)[0]:
                break
            data = os.read(read_fd, 1024)
            if not data:
                break
            chunks.append(data)
            size += len(data)
    except OSError:
        pass
    finally:
        os.close(read_fd)
    return b"".join(chunks).decode("utf-8", "replace") or None


class Attention:
    """The window the user is focused on, and the processes behind it.

    The compositor is the only authority on what has focus, so this asks it
    over the same session environment the notifications use. Everything about
    it is best-effort: no compositor, no answer, or a window that reports no
    pid, and the group is simply empty, which returns victim choice to size
    alone.

    Two ways to ask, picked per call from the session environment:

      niri     `niri msg focused-window`, which hands over the pid directly.
               Wayland has no root window and no _NET_ACTIVE_WINDOW to read,
               so there is no protocol-level way to do this — every compositor
               answers on its own IPC or not at all. That is the whole reason
               this is a branch rather than one command.
      X11      the original two-step xprop walk, kept working for an X session.
    """

    __slots__ = ("cfg", "pid", "group", "checked", "warned")

    def __init__(self, cfg):
        self.cfg = cfg
        self.pid = None
        self.group = frozenset()
        self.checked = 0.0
        self.warned = False

    def refresh(self, now, ppid_of, comm_of, protect):
        if not self.cfg["focus_aware"]:
            self.pid = None
            self.group = frozenset()
            return
        if now - self.checked >= self.cfg["focus_poll"]:
            self.checked = now
            pid = self._focused_pid()
            if pid is not None:
                self.pid = pid
        # Regroup every sweep even when focus itself was not re-read: a browser
        # spawns and retires content processes constantly, and a group computed
        # thirty seconds ago would not contain the tab you just opened.
        self.group = self._group(ppid_of, comm_of, protect)

    def _focused_pid(self):
        session = find_session()
        if session is None:
            return None
        env = dict(session[3])
        env.setdefault("XAUTHORITY", os.path.join(env.get("HOME", "/"), ".Xauthority"))

        if env.get("NIRI_SOCKET"):
            return self._focused_pid_niri(env)
        return self._focused_pid_x11(env)

    def _focused_pid_niri(self, env):
        """The pid out of `niri msg focused-window`.

        The plain text form is parsed rather than --json on purpose: the field
        wanted is one integer on a line of its own, and a json import is a
        module load in a daemon that mlockall()s itself and is written not to
        allocate when the machine is out of memory.

        Root can open the socket regardless of its mode, so there is no
        privilege drop here — same as the xprop path, which relies on
        XAUTHORITY rather than on being the user.
        """
        out = run_capture([NIRI, "msg", "focused-window"], env)
        if not out:
            if not self.warned:
                self.warned = True
                log(f"focus: {NIRI} gave nothing — ranking by size alone")
            return None
        for line in out.splitlines():
            line = line.strip()
            if line.startswith("PID:"):
                try:
                    return int(line.partition(":")[2].strip())
                except ValueError:
                    return None
        # "No window is focused." — the overview, or an empty workspace.
        return None

    def _focused_pid_x11(self, env):
        # _NET_ACTIVE_WINDOW(WINDOW): window id # 0x3200017, 0x0
        out = run_capture([XPROP, "-root", "_NET_ACTIVE_WINDOW"], env)
        if not out:
            if not self.warned:
                self.warned = True
                log(f"focus: {XPROP} gave nothing — ranking by size alone")
            return None
        window = out.rpartition("#")[2].strip().split(",")[0].strip()
        if not window.startswith("0x"):
            return None
        try:
            if int(window, 16) == 0:
                return None  # nothing focused, e.g. the desktop itself
        except ValueError:
            return None

        # _NET_WM_PID(CARDINAL) = 148256
        out = run_capture([XPROP, "-id", window, "_NET_WM_PID"], env)
        if not out or "=" not in out:
            return None  # window sets no pid; nothing to be done about it
        try:
            return int(out.rpartition("=")[2].strip())
        except ValueError:
            return None

    def _group(self, ppid_of, comm_of, protect):
        """Every process belonging to the focused application.

        Up first, to find the top of the application: the browser's parent is
        xfce4-panel and *its* parent is the session, so an unbounded walk would
        end up declaring the entire desktop off limits. Stopping at the first
        protected process is exactly the right bound, because the protect list
        is already the list of things that own the session rather than belong
        to it. Then down, so a browser's content children are covered too.
        """
        pid = self.pid
        if pid is None or pid not in ppid_of:
            return frozenset()

        root = pid
        seen = {pid}
        while True:
            parent = ppid_of.get(root)
            if parent is None or parent <= 1 or parent in seen:
                break
            if comm_of.get(parent, "")[:15] in protect:
                break
            seen.add(parent)
            root = parent

        children = {}
        for child, parent in ppid_of.items():
            children.setdefault(parent, []).append(child)

        group = set()
        stack = [root]
        while stack:
            node = stack.pop()
            if node in group:
                continue
            group.add(node)
            stack.extend(children.get(node, ()))
        return frozenset(group)



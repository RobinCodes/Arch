#!/usr/bin/env python3
"""artwork — choose where the wallpaper and the boot splash get their pictures.

    artwork                    what is set now
    artwork <folder>           rotate through the images in that folder
    artwork <file>             one picture, held
    artwork none               noctalia's own default wallpaper, black boot
    artwork pick               a chooser, for when typing a path is worse
    artwork refresh            re-render the boot splash after adding images

    artwork next               the next picture in the folder, now
    artwork prev               the previous one
    artwork random             any one of them
    artwork which              the path of the picture on screen, and nothing
                               else — so it composes:  xdg-open "$(artwork which)"

    --fit MODE                 how a picture meets a screen it does not match
    --background COLOUR        what shows where the picture does not reach
    --every SECONDS            how long each picture stays up  (off = hold one)
    --output NAME              with next/prev/random/which: one screen, by its
                               connector name (eDP-1, HDMI-A-1); default is all

The three options can be given on their own, to change just that and leave the
rest of the choice alone:   artwork --fit fit --background '#101010'

ONE CHOICE, TWO CONSUMERS

The wallpaper and the boot splash want the same pictures and take them in
completely different ways, so this owns the choice and hands it to each in the
form it needs:

  wallpaper    noctalia already does folders, rotation and transitions. It is
               pointed straight at yours — not at a copy — so adding a file to
               the folder is the whole of adding a wallpaper, and nothing here
               has to watch anything.

  boot splash  plymouth reads its images out of the initramfs, which is built
               once and then frozen, so this cannot point at anything. The
               pictures are rendered to 1366x768 PNG8 and baked in by
               install-plymouth.sh, which is why that half needs root and a
               rebuild and the wallpaper half is instant.

`none` is not "no wallpaper". It hands the desktop back to noctalia's default
and makes the boot splash plain black, which is what a boot with nothing to say
should look like.

WHERE THE SETTINGS LIVE

In noctalia's settings.toml and nowhere else. There is no artwork config file,
because a second copy of `fill_mode` is a second thing to disagree. The edits
here are per key — never per block — so everything this does not name survives,
including noctalia's own [wallpaper.default], [wallpaper.last] and
[wallpaper.monitors.*], and every key under [wallpaper] that has no flag here.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tomllib

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "artwork")
SOURCE_FILE = os.path.join(STATE_DIR, "source")
SPLASH_DIR = os.path.join(STATE_DIR, "splash")

NOCTALIA_SETTINGS = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "noctalia", "settings.toml")

# noctalia's own shipped wallpaper. `artwork none` puts this back explicitly,
# because clearing wallpaper.directory does not on its own bring it back.
NOCTALIA_DEFAULT_WALLPAPERS = (
    "/usr/share/noctalia/assets/noctalia-wallpaper.png",
)

# The action the greeter sync is *supposed* to go through, and the one
# install-greeter-sync.sh grants. See `greeter_sync_report` for why naming it is
# not on its own enough to stop the password prompts.
GREETER_ACTION = "org.noctalia.greeter.apply-appearance"

SPLASH_SIZE = (1366, 768)
EXTENSIONS = (".jpg", ".jpeg", ".png", ".webp", ".avif", ".bmp", ".tif", ".tiff")

FILL_MODES = ("center", "crop", "fit", "stretch", "repeat", "span")
DEFAULT_INTERVAL = 1800

# realpath, not abspath: this is run through a symlink in ~/.local/bin, and
# abspath would resolve HERE to that directory and point the hints below at an
# install-plymouth.sh that is not there.
HERE = os.path.dirname(os.path.realpath(__file__))
INSTALL_PLYMOUTH = os.path.join(HERE, "install-plymouth.sh")
INSTALL_GREETER_SYNC = os.path.join(HERE, "install-greeter-sync.sh")


def images_in(folder):
    try:
        names = sorted(os.listdir(folder))
    except OSError:
        return []
    return [os.path.join(folder, n) for n in names
            if n.lower().endswith(EXTENSIONS)
            and os.path.isfile(os.path.join(folder, n))]


def sources_for(target):
    """The pictures behind a source, whether it names a folder or one file."""
    if not target:
        return []
    if os.path.isfile(target):
        return [target] if target.lower().endswith(EXTENSIONS) else []
    return images_in(target)


def read_source():
    try:
        with open(SOURCE_FILE, encoding="utf-8") as fh:
            value = fh.read().strip()
    except OSError:
        return None
    return value or None


def write_source(value):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = SOURCE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(value + "\n")
    os.replace(tmp, SOURCE_FILE)


# --- noctalia's settings.toml, one key at a time -----------------------------
#
# Rewriting the whole [wallpaper] block is what the previous version did, and it
# took [wallpaper.default], [wallpaper.last] and [wallpaper.monitors.*] with it
# every time: the scan meant to stop at the next table stopped at the first line
# starting with "[", and noctalia indents its sub-tables by four spaces, so it
# stopped at none of them. That deletion is what looked like "noctalia drops its
# own tables when the directory goes away". noctalia did not. This did.

HEADER_RE = re.compile(r"^\s*\[\[?[^\[\]]+\]\]?\s*(#.*)?$")
BARE_KEY_RE = re.compile(r"^(\s*)([A-Za-z0-9_-]+)\s*=")


def toml_literal(value):
    if isinstance(value, bool):          # before int: bool is an int in Python
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    return '"{}"'.format(str(value).replace("\\", "\\\\").replace('"', '\\"'))


def is_header(line):
    return bool(HEADER_RE.match(line))


def header_name(line):
    return line.strip().strip("[]")


def table_span(lines, name):
    """(header index, end) for `name`'s own body. `end` is the next table header
    at any indentation, so a sub-table ends its parent rather than being eaten
    by it."""
    want = "[{}]".format(name)
    for index, line in enumerate(lines):
        if line.strip() == want:
            end = index + 1
            while end < len(lines) and not is_header(lines[end]):
                end += 1
            return index, end
    return None


def ensure_table(lines, name):
    """The span of `name`, creating it in sorted position if it is not there."""
    span = table_span(lines, name)
    if span:
        return span

    parts = name.split(".")
    if len(parts) == 1:
        # A top-level table has to come before its own sub-tables, or they stop
        # being its sub-tables. Otherwise the end of the file will do.
        at = len(lines)
        for index, line in enumerate(lines):
            if is_header(line) and header_name(line).startswith(name + "."):
                at = index
                break
    else:
        parent = ".".join(parts[:-1])
        _, at = ensure_table(lines, parent)
        # Walk the parent's existing sub-tables and stop at the first that
        # sorts after this one, so the file stays in the order noctalia writes.
        index = at
        while index < len(lines):
            if not (is_header(lines[index])
                    and header_name(lines[index]).startswith(parent + ".")):
                break
            if header_name(lines[index]) > name:
                break
            index += 1
            while index < len(lines) and not is_header(lines[index]):
                index += 1
            at = index

    if at > 0 and not lines[at - 1].endswith("\n"):
        lines[at - 1] += "\n"
    lines[at:at] = ["\n", "{}[{}]\n".format("    " * (len(parts) - 1), name)]
    return table_span(lines, name)


def set_key(lines, table, key, value):
    """Set one key inside one table, touching no other line of the file."""
    start, end = ensure_table(lines, table)
    literal = toml_literal(value)
    indent = "    " * table.count(".")
    wanted = re.compile(r"^(\s*)" + re.escape(key) + r"\s*=")

    for index in range(start + 1, end):
        match = wanted.match(lines[index])
        if match:
            lines[index] = "{}{} = {}\n".format(match.group(1), key, literal)
            return

    at = None
    for index in range(start + 1, end):
        match = BARE_KEY_RE.match(lines[index])
        if not match:
            continue
        indent = match.group(1)
        if match.group(2) > key:
            at = index
            break
    if at is None:
        at = end
        while at > start + 1 and lines[at - 1].strip() == "":
            at -= 1
    lines.insert(at, "{}{} = {}\n".format(indent, key, literal))


def flatten(data, prefix=()):
    out = {}
    for key, value in data.items():
        path = prefix + (key,)
        if isinstance(value, dict):
            out.update(flatten(value, path))
        else:
            out[path] = value
    return out


def read_settings():
    try:
        with open(NOCTALIA_SETTINGS, "rb") as fh:
            return tomllib.load(fh)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def schema_errors(path):
    """noctalia's own verdict on a settings file. Warnings are not errors — it
    warns about keys it does not know, and a newer noctalia writing keys an
    older one never heard of is not this script's argument to have."""
    try:
        result = subprocess.run(["noctalia", "config", "validate", path],
                                capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return []       # no noctalia to ask; the TOML checks already passed
    if result.returncode == 0:
        return []
    return [line.strip() for line in result.stderr.splitlines()
            if line.startswith("ERROR")] or ["config validate said no"]


def apply_settings(changes):
    """Set `{(table, key): value}` in noctalia's settings.toml, and nothing else.

    Four things stand between the edit and the real file, because this is
    somebody else's config and a bad write costs them their whole setup: the
    result has to parse, nothing outside `changes` may have moved, every change
    has to have actually landed, and noctalia's own schema has to accept it. The
    previous file is kept alongside as .artwork-bak.
    """
    if not changes:
        return True
    try:
        with open(NOCTALIA_SETTINGS, encoding="utf-8") as fh:
            text = fh.read()
    except OSError as error:
        print("  ! cannot read {}: {}".format(NOCTALIA_SETTINGS, error),
              file=sys.stderr)
        return False

    try:
        before = flatten(tomllib.loads(text))
    except tomllib.TOMLDecodeError as error:
        print("  ! {} does not parse as TOML: {}".format(NOCTALIA_SETTINGS, error),
              file=sys.stderr)
        return False

    lines = text.splitlines(keepends=True)
    for (table, key), value in changes.items():
        set_key(lines, table, key, value)
    edited = "".join(lines)

    try:
        after = flatten(tomllib.loads(edited))
    except tomllib.TOMLDecodeError as error:
        print("  ! the edit would not parse; leaving the file alone: {}".format(error),
              file=sys.stderr)
        return False

    intended = {tuple(table.split(".")) + (key,): value
                for (table, key), value in changes.items()}
    missing = object()
    stray = {path for path in set(before) | set(after)
             if before.get(path, missing) != after.get(path, missing)} - set(intended)
    if stray:
        print("  ! the edit would also change {}; leaving the file alone".format(
            ", ".join(".".join(p) for p in sorted(stray))), file=sys.stderr)
        return False
    for path, value in intended.items():
        if after.get(path, missing) != value:
            print("  ! {} did not take; leaving the file alone".format(".".join(path)),
                  file=sys.stderr)
            return False

    tmp = NOCTALIA_SETTINGS + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(edited)
    except OSError as error:
        print("  ! cannot write {}: {}".format(tmp, error), file=sys.stderr)
        return False

    problems = schema_errors(tmp)
    if problems:
        os.unlink(tmp)
        print("  ! noctalia will not have it:", file=sys.stderr)
        for line in problems:
            # It complains about the scratch copy it was handed; name the file
            # the reader actually has.
            print("    {}".format(line.replace(tmp, NOCTALIA_SETTINGS)),
                  file=sys.stderr)
        return False

    try:
        shutil.copy2(NOCTALIA_SETTINGS, NOCTALIA_SETTINGS + ".artwork-bak")
    except OSError:
        pass
    os.replace(tmp, NOCTALIA_SETTINGS)

    subprocess.run(["noctalia", "msg", "config-reload"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   check=False)
    return True


def noctalia(*args):
    """`noctalia msg ...` — (ok, output)."""
    try:
        result = subprocess.run(["noctalia", "msg", *args],
                                capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return False, ""
    return result.returncode == 0, result.stdout.strip()


# --- the greeter sync, which is where the password prompts came from ---------

def pkcheck(action):
    """Is `action` already ours without a prompt?

    Asked rather than found out the hard way: without --allow-user-interaction
    pkcheck never opens a dialog, and /etc/polkit-1/rules.d is not readable as a
    user, so the rule file cannot simply be looked for.
    """
    if not shutil.which("pkcheck"):
        return None
    try:
        result = subprocess.run(
            ["pkcheck", "--action-id", action, "--process", str(os.getpid())],
            capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return result.returncode == 0


def greeter_pin():
    """Make the greeter sync go through pkexec, if it is on and it does not.

    noctalia copies each new wallpaper to its own login greeter through a root
    helper, and runs that helper through whichever privilege wrapper it finds.
    It prefers `run0` — and run0 does its work by asking systemd for a transient
    unit, so the polkit action that actually fires is
    org.freedesktop.systemd1.manage-units (auth_admin_keep), not the
    org.noctalia.greeter.apply-appearance the shipped policy is about. Measured
    here, in polkitd's own log, at exactly the rotation interval:

        16:35:58  FAILED to authenticate ... org.freedesktop.systemd1.manage-units
        17:05:58  FAILED to authenticate ... org.freedesktop.systemd1.manage-units

    That is why install-greeter-sync.sh looked like it did nothing: it grants
    the right action to a mechanism that never asks for it. Pinning the wrapper
    to `pkexec` puts the call back on the action the policy — and that rule —
    names, and the prompt stops. The alternative, a rule for manage-units, would
    have meant handing over every unit on the system, which is the whole of root
    for the sake of a picture on the login screen.
    """
    sync = read_settings().get("shell", {}).get("greeter_sync", {})
    if not sync.get("auto_sync", True):
        return {}
    if sync.get("privilege_command") == "pkexec":
        return {}
    return {("shell.greeter_sync", "privilege_command"): "pkexec"}


def greeter_sync_report():
    """(line, hint) on whether a wallpaper change can still ask for a password."""
    sync = read_settings().get("shell", {}).get("greeter_sync", {})
    if not sync.get("auto_sync", True):
        return "off — the login screen keeps its own look", None

    wrapper = sync.get("privilege_command") or "auto, which means run0"
    granted = pkcheck(GREETER_ACTION)
    if granted is None:
        return ("on, via {} — no pkcheck here, so whether it will ask "
                "is not knowable".format(wrapper), None)
    if not granted:
        return ("on, via {} — it will ask for your password".format(wrapper),
                "  ! nothing grants {} yet. Once, and never again:\n"
                "        sudo bash {}".format(GREETER_ACTION, INSTALL_GREETER_SYNC))
    if sync.get("privilege_command") != "pkexec":
        return ("on, via {} — it will ask for your password".format(wrapper),
                "  ! run0 asks polkit for systemd1.manage-units, which no rule\n"
                "    grants, rather than the action that is. Any artwork command\n"
                "    that writes settings pins it; the smallest is:\n"
                "        artwork refresh")
    return "on, via pkexec — silent, no password", None


# --- the wallpaper ----------------------------------------------------------

def set_wallpaper(target, options):
    """Point noctalia at `target` — a folder to rotate through, one file to
    hold, or None to hand the wallpaper back to noctalia's own default."""
    rotating = bool(target) and os.path.isdir(target)
    settings = read_settings()
    automation = settings.get("wallpaper", {}).get("automation", {})

    changes = dict(options)
    changes.update(greeter_pin())
    changes[("wallpaper", "directory")] = target if rotating else ""
    changes[("wallpaper", "transition_on_startup")] = True
    changes[("wallpaper.automation", "enabled")] = bool(
        rotating and options.get(("wallpaper.automation", "enabled"), True))
    changes.setdefault(("wallpaper.automation", "interval_seconds"),
                       automation.get("interval_seconds", DEFAULT_INTERVAL))
    changes.setdefault(("wallpaper.automation", "order"),
                       automation.get("order", "random"))
    changes.setdefault(("wallpaper.automation", "recursive"),
                       automation.get("recursive", False))

    if not apply_settings(changes):
        return False

    if target and not rotating:
        ok, _ = noctalia("wallpaper-set", target)
        if not ok:
            # The settings edit has landed either way, so this is a warning
            # rather than a failure — but say plainly that the desktop has not
            # changed, because noctalia holds the current wallpaper in tables of
            # its own that only it should write.
            print("  ! noctalia would not take it — is it running? The choice "
                  "is saved,\n"
                  "  ! but the desktop will not change until noctalia is up "
                  "and you run\n"
                  "  !     artwork {}".format(target), file=sys.stderr)
        else:
            _, showing = noctalia("wallpaper-get")
            if showing and os.path.realpath(showing) != os.path.realpath(target):
                print("  ! noctalia is showing {} instead".format(showing),
                      file=sys.stderr)
    elif rotating:
        # Put one up now rather than waiting out the rotation interval, so the
        # command visibly did something.
        noctalia("wallpaper-random")
    else:
        default = next((p for p in NOCTALIA_DEFAULT_WALLPAPERS
                        if os.path.exists(p)), None)
        if default is None:
            print("  ! noctalia's default wallpaper asset is not installed;",
                  "the desktop will keep whatever is on it", file=sys.stderr)
        elif noctalia("wallpaper-set", default)[0]:
            print("   default wallpaper: {}".format(default))
        else:
            print("  ! noctalia would not take it — is it running? The choice "
                  "is saved,\n"
                  "  ! but the desktop will keep whatever is on it for now.",
                  file=sys.stderr)
    return True


# --- the boot splash --------------------------------------------------------

def hex_to_rgb(colour):
    """(r, g, b) for a hex colour, or None for anything else — a palette role
    like `surface` only means something inside noctalia, which is not here."""
    if not colour or not colour.startswith("#"):
        return None
    digits = colour[1:]
    if len(digits) in (3, 4):
        digits = "".join(c * 2 for c in digits)
    if len(digits) in (6, 8) and all(c in "0123456789abcdefABCDEF" for c in digits):
        return tuple(int(digits[i:i + 2], 16) for i in (0, 2, 4))
    return None


def render_splashes(target, mode="crop", colour=None):
    """Render every picture behind `target` to a 16:9 splash rendition.

    Staged here rather than written straight into the plymouth theme because
    the theme lives under /usr/share and this runs as you. install-plymouth.sh
    picks them up from here.
    """
    try:
        from PIL import Image, ImageEnhance, ImageFilter
    except ImportError:
        print("  ! Pillow is missing, so nothing was staged for the boot splash:",
              file=sys.stderr)
        print("        sudo pacman -S python-pillow", file=sys.stderr)
        return 0

    sources = sources_for(target)
    if not sources:
        return 0

    shutil.rmtree(SPLASH_DIR, ignore_errors=True)
    os.makedirs(SPLASH_DIR, exist_ok=True)

    target_w, target_h = SPLASH_SIZE
    ground = hex_to_rgb(colour)
    made = 0

    def scaled(image, factor):
        return image.resize((max(1, round(image.width * factor)),
                             max(1, round(image.height * factor))), Image.LANCZOS)

    def cover(image):
        big = scaled(image, max(target_w / image.width, target_h / image.height))
        left = (big.width - target_w) // 2
        top = (big.height - target_h) // 2
        return big.crop((left, top, left + target_w, top + target_h))

    def contain(image):
        return scaled(image, min(target_w / image.width, target_h / image.height))

    def backdrop(image):
        """What shows where the picture does not reach. The colour when one is
        set; otherwise a blurred, darkened copy of the picture itself, which
        beats flat black for a portrait picture on a landscape screen."""
        if ground is not None:
            return Image.new("RGB", SPLASH_SIZE, ground)
        return ImageEnhance.Brightness(
            cover(image).filter(ImageFilter.GaussianBlur(target_w / 28))).enhance(0.55)

    def centred(front, back):
        back.paste(front, ((target_w - front.width) // 2,
                           (target_h - front.height) // 2))
        return back

    for path in sources:
        try:
            with Image.open(path) as opened:
                image = opened.convert("RGB")

                if mode == "stretch":
                    out = image.resize(SPLASH_SIZE, Image.LANCZOS)
                elif mode == "fit":
                    out = centred(contain(image), backdrop(image))
                elif mode == "center":
                    front = image
                    if front.width > target_w or front.height > target_h:
                        left = max(0, (front.width - target_w) // 2)
                        top = max(0, (front.height - target_h) // 2)
                        front = front.crop((left, top,
                                            left + min(front.width, target_w),
                                            top + min(front.height, target_h)))
                    out = centred(front, backdrop(image))
                elif mode == "repeat":
                    out = Image.new("RGB", SPLASH_SIZE,
                                    ground if ground is not None else (0, 0, 0))
                    for y in range(0, target_h, image.height):
                        for x in range(0, target_w, image.width):
                            out.paste(image, (x, y))
                else:
                    # crop, and span — one screen is the whole span here. A
                    # portrait picture cropped to cover a landscape screen loses
                    # most of itself, so below 95% of the target ratio it is
                    # fitted onto its own backdrop instead.
                    if image.width / image.height >= (target_w / target_h) * 0.95:
                        out = cover(image)
                    else:
                        out = centred(contain(image), backdrop(image))

                out.save(os.path.join(SPLASH_DIR, "{:03d}.jpg".format(made)),
                         "JPEG", quality=88, optimize=True)
                made += 1
        except Exception as error:
            print("  - {}: {}".format(os.path.basename(path), error), file=sys.stderr)
    return made


def boot_hint(count):
    print()
    if count:
        print("  Boot splash: {} image(s) staged.".format(count))
    else:
        print("  Boot splash: black.")
    print("  That half needs root and an initramfs rebuild:")
    print("      sudo bash {}".format(INSTALL_PLYMOUTH))


# --- options ----------------------------------------------------------------

def option_changes(args):
    """The settings the flags ask for. `None` when one of them is unusable."""
    changes = {}
    if args.fit:
        changes[("wallpaper", "fill_mode")] = args.fit
    if args.background is not None:
        colour = args.background.strip()
        # "101010" and "#101010" mean the same thing to everyone but TOML.
        if colour and not colour.startswith("#") and hex_to_rgb("#" + colour):
            colour = "#" + colour
        changes[("wallpaper", "fill_color")] = colour
    if args.every is not None:
        every = args.every.strip().lower()
        if every in ("off", "never", "no", "hold"):
            changes[("wallpaper.automation", "enabled")] = False
        else:
            try:
                seconds = int(every)
            except ValueError:
                print("artwork: --every wants whole seconds, or 'off': {}".format(
                    args.every), file=sys.stderr)
                return None
            if seconds <= 0:
                changes[("wallpaper.automation", "enabled")] = False
            elif seconds < 5:
                print("artwork: --every under 5 seconds is a strobe, not a "
                      "wallpaper", file=sys.stderr)
                return None
            else:
                changes[("wallpaper.automation", "enabled")] = True
                changes[("wallpaper.automation", "interval_seconds")] = seconds
    return changes


def describe_every(settings):
    automation = settings.get("wallpaper", {}).get("automation", {})
    if not automation.get("enabled", False):
        return "held — it does not change on its own"
    seconds = int(automation.get("interval_seconds", DEFAULT_INTERVAL))
    if seconds >= 3600 and seconds % 3600 == 0:
        every = "{} hour(s)".format(seconds // 3600)
    elif seconds >= 60 and seconds % 60 == 0:
        every = "{} minute(s)".format(seconds // 60)
    else:
        every = "{} second(s)".format(seconds)
    return "{}, every {} ({}s)".format(
        automation.get("order", "random"), every, seconds)


def report_settings(wallpaper):
    print("   fit:        {}".format(wallpaper.get("fill_mode", "crop")))
    colour = wallpaper.get("fill_color")
    if colour and hex_to_rgb(colour) is None:
        print("   background: {}  — a noctalia palette role. The boot splash "
              "cannot resolve one,\n               so it keeps its own blurred "
              "backdrop.".format(colour))
    else:
        print("   background: {}".format(colour or "none — the picture's own edges"))


# --- commands ---------------------------------------------------------------

def cmd_show():
    source = read_source()
    settings = read_settings()
    greeter, hint = greeter_sync_report()

    if source is None:
        print("artwork: not set")
        print("  wallpaper   whatever noctalia is configured with")
        print("  boot splash whatever plymouth is themed with")
    elif source == "none":
        print("artwork: none")
        print("  wallpaper   noctalia's default")
        print("  boot splash black")
    else:
        pictures = sources_for(source)
        staged = len(images_in(SPLASH_DIR))
        print("artwork: {}".format(source))
        if not os.path.exists(source):
            print("  ! it is not there any more")
        elif os.path.isfile(source):
            print("  one picture, held")
        else:
            print("  {} image(s) in the folder".format(len(pictures)))
        print("  rotation    {}".format(describe_every(settings)))
        print("  boot splash {} staged for the next install-plymouth.sh run".format(staged))
        if os.path.exists(source) and len(pictures) != staged:
            print("  ! source and staged copies differ — run:  artwork refresh")

    report_settings(settings.get("wallpaper", {}))
    print("   greeter:    {}".format(greeter))
    if hint:
        print(hint)
    return 0


def cmd_set(target, options):
    target = os.path.abspath(os.path.expanduser(target))
    if not os.path.exists(target):
        print("artwork: no such folder or file: {}".format(target), file=sys.stderr)
        return 1
    pictures = sources_for(target)
    if not pictures:
        if os.path.isfile(target):
            print("artwork: not an image: {}".format(target), file=sys.stderr)
        else:
            print("artwork: no images in {}".format(target), file=sys.stderr)
        print("  looked for: {}".format(", ".join(EXTENSIONS)), file=sys.stderr)
        return 1

    if os.path.isfile(target):
        print(">> One picture: {}".format(os.path.basename(target)))
        print(">> Holding it — noctalia's rotation is off")
    else:
        print(">> {} image(s) in {}".format(len(pictures), target))
        print(">> Pointing noctalia's wallpaper rotation at it")
    if not set_wallpaper(target, options):
        return 1
    write_source(target)

    wallpaper = read_settings().get("wallpaper", {})
    print(">> Rendering boot splash copies")
    count = render_splashes(target, wallpaper.get("fill_mode", "crop"),
                            wallpaper.get("fill_color"))
    print("   {} rendered to {}".format(count, SPLASH_DIR))
    report_settings(wallpaper)
    boot_hint(count)
    return 0


def cmd_none(options):
    print(">> Handing the wallpaper back to noctalia")
    if not set_wallpaper(None, options):
        return 1
    shutil.rmtree(SPLASH_DIR, ignore_errors=True)
    write_source("none")
    boot_hint(0)
    return 0


def cmd_options_only(options):
    """The flags on their own: change those, leave the source where it is."""
    changes = dict(options)
    changes.update(greeter_pin())
    if not apply_settings(changes):
        return 1

    settings = read_settings()
    report_settings(settings.get("wallpaper", {}))
    print("   rotation:   {}".format(describe_every(settings)))

    source = read_source()
    looks_different = any(key in (("wallpaper", "fill_mode"),
                                  ("wallpaper", "fill_color"))
                          for key in options)
    if looks_different and source and source != "none" and os.path.exists(source):
        # --every changes nothing a rendered splash can show, so only fit and
        # background are worth re-rendering for.
        print(">> Re-rendering the boot splash to match")
        wallpaper = settings.get("wallpaper", {})
        count = render_splashes(source, wallpaper.get("fill_mode", "crop"),
                                wallpaper.get("fill_color"))
        print("   {} rendered".format(count))
        boot_hint(count)
    return 0


def cmd_refresh():
    # The greeter pin first, and unconditionally: it is the one thing here that
    # is worth doing even when there is nothing to re-render.
    if not apply_settings(greeter_pin()):
        return 1
    source = read_source()
    if not source or source == "none":
        print("artwork: nothing to refresh — no folder is set", file=sys.stderr)
        return 1
    if not os.path.exists(source):
        print("artwork: it is gone: {}".format(source), file=sys.stderr)
        return 1
    wallpaper = read_settings().get("wallpaper", {})
    print(">> Re-rendering from {}".format(source))
    count = render_splashes(source, wallpaper.get("fill_mode", "crop"),
                            wallpaper.get("fill_color"))
    print("   {} rendered".format(count))
    boot_hint(count)
    return 0


def current_wallpaper(output=None):
    """The picture noctalia is showing — on `output`, or its default when no
    output is named. None when it will not say, which is also what a stopped
    noctalia looks like."""
    ok, path = noctalia("wallpaper-get", *([output] if output else []))
    return path if ok and path else None


# What the user types, and what noctalia calls it.
STEPS = {"next": "wallpaper-next", "prev": "wallpaper-previous",
         "random": "wallpaper-random"}


def cmd_step(step, output):
    """next, prev, random — move the rotation along by hand.

    What noctalia steps through is wallpaper.directory, so that is what is
    checked, not artwork's own record: a held file and `none` both leave the
    directory empty, and a directory set from noctalia's settings window is
    just as steppable as one set here. The rotation timer is left alone — this
    is a nudge, not a new schedule.
    """
    wallpaper = read_settings().get("wallpaper", {})
    if not wallpaper.get("directory"):
        source = read_source()
        if source and source != "none" and os.path.isfile(source):
            print("artwork: one picture is held, so there is nothing to step to",
                  file=sys.stderr)
        elif source == "none":
            print("artwork: the wallpaper is noctalia's own default, so there "
                  "is nothing to step to", file=sys.stderr)
        else:
            print("artwork: no folder is set, so there is nothing to step "
                  "through", file=sys.stderr)
        print("  give it a folder:  artwork <folder>", file=sys.stderr)
        return 1

    before = current_wallpaper(output)
    ok, _ = noctalia(STEPS[step], *([output] if output else []))
    if not ok:
        print("artwork: noctalia would not do it — is it running{}?".format(
            ", and is {} a connector it knows".format(output) if output else ""),
            file=sys.stderr)
        return 1

    now = current_wallpaper(output)
    if now is None:
        print(">> {}".format(step))
        return 0
    count = len(images_in(wallpaper["directory"]))
    if now == before and count <= 1:
        print(">> {} — the folder has one picture, so it is still:".format(step))
    elif now == before:
        # random can land where it started; next/prev only do that at a wrap
        # through a folder of one, which the branch above has already had.
        print(">> {} — landed on the same one:".format(step))
    else:
        print(">> {}:".format(step))
    print("   {}".format(now))
    return 0


def cmd_which(output):
    """The path, bare, on stdout; anything else on stderr. It is the one command
    here meant for $(...) as much as for reading."""
    path = current_wallpaper(output)
    if path is None:
        print("artwork: noctalia is not saying — is it running{}?".format(
            ", and is {} a connector it knows".format(output) if output else ""),
            file=sys.stderr)
        return 1
    print(path)
    return 0


def cmd_pick(options, want_file):
    """A chooser, using whatever this machine has.

    zenity and kdialog are not installed here by default and yad is — the same
    tool nightlight-gui uses — so that is the one tried first. Falling back to
    a typed path rather than failing: this is a convenience, not the interface.
    """
    start = read_source() or os.path.expanduser("~/Pictures")
    if start == "none" or not os.path.exists(start):
        start = os.path.expanduser("~/Pictures")
    if os.path.isfile(start):
        start = os.path.dirname(start)

    if want_file:
        candidates = (
            ["yad", "--file", "--title=Artwork picture",
             "--filename={}/".format(start)],
            ["zenity", "--file-selection", "--title=Artwork picture",
             "--filename={}/".format(start)],
            ["kdialog", "--getopenfilename", start],
        )
    else:
        candidates = (
            ["yad", "--file", "--directory", "--title=Artwork folder",
             "--filename={}/".format(start)],
            ["zenity", "--file-selection", "--directory",
             "--title=Artwork folder", "--filename={}/".format(start)],
            ["kdialog", "--getexistingdirectory", start],
        )

    for argv in candidates:
        if not shutil.which(argv[0]):
            continue
        try:
            result = subprocess.run(argv, capture_output=True, text=True,
                                    timeout=300)
        except (OSError, subprocess.SubprocessError):
            continue
        if result.returncode != 0:
            print("artwork: cancelled")
            return 0
        chosen = result.stdout.strip().rstrip("|")
        if chosen:
            return cmd_set(chosen, options)
        return 0

    print("artwork: no chooser installed (yad, zenity or kdialog).",
          file=sys.stderr)
    print("  Pass the path instead:  artwork /path/to/folder", file=sys.stderr)
    return 1


def main():
    parser = argparse.ArgumentParser(
        prog="artwork", description=__doc__.split("\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="artwork <folder|file> | none | pick | refresh | "
               "next | prev | random | which")
    parser.add_argument("target", nargs="?",
                        help="a folder, one image file, or: none, pick, "
                             "refresh, next, prev, random, which")
    parser.add_argument("--fit", choices=FILL_MODES, metavar="MODE",
                        help="how a picture meets a screen it does not match: "
                             + ", ".join(FILL_MODES))
    parser.add_argument("--background", metavar="COLOUR",
                        help="what shows where the picture does not reach: "
                             "#rrggbb, #rrggbbaa, a noctalia palette role such "
                             "as surface, or '' for none")
    parser.add_argument("--every", metavar="SECONDS",
                        help="how long each picture stays up, or 'off' to hold one")
    parser.add_argument("--file", action="store_true",
                        help="with 'pick': choose one image rather than a folder")
    parser.add_argument("--output", metavar="NAME",
                        help="with next, prev, random or which: one screen, by "
                             "connector name — default is all of them")
    args = parser.parse_args()

    if args.output and args.target not in (*STEPS, "which"):
        parser.error("--output only goes with next, prev, random or which")

    options = option_changes(args)
    if options is None:
        return 1

    if args.target is None:
        if args.file:
            return cmd_pick(options, True)
        return cmd_options_only(options) if options else cmd_show()
    if args.target == "none":
        return cmd_none(options)
    if args.target == "pick":
        return cmd_pick(options, args.file)
    if args.target == "refresh":
        return cmd_refresh()
    if args.target in STEPS or args.target == "which":
        if options:
            parser.error("--fit, --background and --every do not go with {}; "
                         "give them on their own".format(args.target))
        if args.target == "which":
            return cmd_which(args.output)
        return cmd_step(args.target, args.output)
    return cmd_set(args.target, options)


if __name__ == "__main__":
    sys.exit(main())

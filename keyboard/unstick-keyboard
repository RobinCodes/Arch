#!/usr/bin/env bash
# unstick-keyboard — recover a session that has stopped taking input, without
# a reboot.
#
# WHAT THIS USED TO UNDO, AND WHAT IT UNDOES NOW
#
# On X11 the failure was specific and nasty. xfce4-screensaver held a logind
# delay inhibitor on sleep so it could raise the lock screen before suspend;
# locking meant XGrabKeyboard on the root window. If logind's
# InhibitDelayMaxSec elapsed first it suspended anyway and froze user.slice
# mid-lock, and what came back was a screensaver stuck partway through locking,
# still holding the keyboard grab, with no lock window on screen to type into.
# Every keystroke went to that grab and vanished.
#
# That exact bug cannot happen here. There is no XGrabKeyboard on Wayland and
# no root window to grab: input routing belongs to the compositor, and a client
# that wedges loses input rather than capturing everybody else's. niri keeps
# taking keys no matter what any client does.
#
# Two things did survive the port, though, which is why this still exists:
#
#   1. Suspended processes. oom-defender freezes with SIGSTOP and resumes on
#      its own, but only while it is alive to remember what it froze. Killed or
#      crashed mid-episode, its victims stay stopped forever. A stopped process
#      that owns a window you are trying to type into looks exactly like a dead
#      keyboard, and this is now the most likely cause rather than the least.
#
#   2. A wedged lock screen. noctalia locks through ext-session-lock, and that
#      protocol is deliberately fail-closed: if the lock client dies without
#      unlocking, the compositor keeps the session locked and shows a blank
#      screen. That is the right security choice and a terrible place to be
#      stuck, because the thing that could unlock it is the thing that died.
#      Restarting it puts a password prompt back on screen.
#
# The logind drop-in installed beside this is still doing real work, for the
# same reason as before with a different daemon: noctalia takes a sleep *delay*
# inhibitor to lock before suspend ("Lock before sleep" in
# `systemd-inhibit --list`), and on a machine deep in swap the shipped 5s
# budget is tight. 30s is the cost ceiling, not the cost.
#
# Usage: unstick-keyboard [--quiet] [--dry-run]

set -euo pipefail

quiet=false
dry_run=false
for arg in "$@"; do
	case $arg in
		--quiet) quiet=true ;;
		--dry-run) dry_run=true ;;
		-h|--help) sed -n '2,40p' "$0" | sed 's/^# \?//'; exit 0 ;;
		*) echo "unstick-keyboard: unknown option $arg" >&2; exit 1 ;;
	esac
done

say() { $quiet || echo "$*"; }
run() { $dry_run && { say "  would run: $*"; return 0; }; "$@"; }

# Runnable from a bar launcher, from a keybind, and from a TTY or ssh — which
# is the fallback when the graphical session is showing nothing useful at all.
# Ctrl+Alt+F2 still switches VT under any compositor, so that route stays open.
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
	# Pick up the session's own environment so `noctalia msg` and friends have
	# a bus to talk to. The user manager has it whenever a session is up.
	if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
		export XDG_RUNTIME_DIR="/run/user/$(id -u)"
	fi
	if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
		export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
	fi
	eval "$(systemctl --user show-environment 2>/dev/null \
		| grep -E '^(WAYLAND_DISPLAY|NIRI_SOCKET)=' \
		| sed 's/^/export /')" || true
	say "no display in the environment, took it from the user manager"
fi

did_something=false

# --- 1. Resume anything left suspended --------------------------------------
# Caveat, unchanged: a shell job you suspended yourself with Ctrl+Z is also
# state T and will be resumed too. That is the intended trade — this runs when
# the machine is already unusable.
mapfile -t stopped < <(ps -u "$(id -u)" -o pid=,stat=,comm= | awk '$2 ~ /^T/ {print $1" "$3}')
if [ ${#stopped[@]} -gt 0 ]; then
	say "resuming ${#stopped[@]} suspended process(es):"
	for entry in "${stopped[@]}"; do
		pid=${entry%% *}
		name=${entry#* }
		say "  SIGCONT $name[$pid]"
		run kill -CONT "$pid" 2>/dev/null || true
	done
	did_something=true
else
	say "no suspended processes"
fi

# --- 2. Is the session locked, and is anything still holding it? ------------
# noctalia reports its own view; the compositor is the authority on whether the
# lock surface is up. Disagreement between them is the wedge.
locked=unknown
if command -v noctalia >/dev/null 2>&1; then
	locked=$(noctalia msg status 2>/dev/null \
		| python3 -c 'import json,sys
try: print("yes" if json.load(sys.stdin).get("locked") else "no")
except Exception: print("unknown")' 2>/dev/null || echo unknown)
fi
say "session locked: $locked"

# --- 3. Restart the shell if it is not answering ----------------------------
# `noctalia msg status` is a round trip through its IPC, so a shell that cannot
# answer it is a shell that has stopped servicing its event loop — which is
# exactly the state that leaves a lock on screen with nothing behind it.
if command -v noctalia >/dev/null 2>&1; then
	if noctalia msg status >/dev/null 2>&1; then
		say "noctalia is answering its IPC (not wedged)"
	else
		mapfile -t shell_pids < <(pgrep -u "$(id -u)" -x noctalia 2>/dev/null || true)
		if [ ${#shell_pids[@]} -gt 0 ]; then
			for pid in "${shell_pids[@]}"; do
				say "noctalia[$pid] is not answering — restarting it"
				# SIGCONT first: a stopped process cannot act on SIGTERM, and
				# killing it while stopped leaves the lock surface up until the
				# compositor notices the client is gone.
				run kill -CONT "$pid" 2>/dev/null || true
				run kill -TERM "$pid" 2>/dev/null || true
			done
			did_something=true

			if ! $dry_run; then
				for _ in $(seq 10); do
					pgrep -u "$(id -u)" -x noctalia >/dev/null 2>&1 || break
					sleep 0.3
				done
				if pgrep -u "$(id -u)" -x noctalia >/dev/null 2>&1; then
					say "  still alive, sending SIGKILL"
					pkill -KILL -u "$(id -u)" -x noctalia 2>/dev/null || true
					sleep 0.5
				fi
			fi
		else
			say "noctalia is not running"
		fi

		# Bring it back. Without this the session has no bar, no notifications
		# and — the part that matters here — no way to authenticate a lock that
		# the compositor is still showing.
		say "starting a fresh noctalia"
		if ! $dry_run; then
			setsid noctalia >/dev/null 2>&1 &
			disown 2>/dev/null || true
		fi
		did_something=true
	fi
fi

# --- 4. Report --------------------------------------------------------------
# The notification matters more than the terminal output: this is normally
# launched from a bar button or a keybind by someone who cannot see much.
if ! $dry_run && command -v notify-send >/dev/null; then
	if $did_something; then
		notify-send -i input-keyboard -u critical "Session unstuck" \
			"Resumed suspended processes and restarted the shell if it was wedged. If input still does nothing, switch to a TTY with Ctrl+Alt+F2." 2>/dev/null || true
	else
		notify-send -i input-keyboard "Nothing was stuck" \
			"No suspended processes and the shell is answering — the problem is something else." 2>/dev/null || true
	fi
fi

say "done"

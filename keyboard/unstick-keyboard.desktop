[Desktop Entry]
Type=Application
Version=1.1
Name=Unstick Keyboard
GenericName=Session Input Recovery
Comment=Resume frozen processes and restart a wedged shell, without rebooting
Exec=/usr/local/bin/unstick-keyboard --quiet
Icon=input-keyboard
Terminal=false
Categories=System;
Keywords=keyboard;stuck;frozen;lock;unlock;wedged;shell;
StartupNotify=false

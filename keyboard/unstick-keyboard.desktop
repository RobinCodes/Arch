[Desktop Entry]
Type=Application
Version=1.1
Name=Unstick Keyboard
GenericName=Input Grab Recovery
Comment=Release the screensaver's stuck keyboard grab without rebooting
Exec=/usr/local/bin/unstick-keyboard --quiet
Icon=input-keyboard
Terminal=false
Categories=System;
Keywords=keyboard;grab;stuck;frozen;screensaver;unlock;
StartupNotify=false

#!/bin/bash
# nightlight [--auto] [0-100]   — get or set the night light intensity.
# nightlight --mode [auto|manual] — get or set how nightlight-auto behaves.
#
# 0 = off (6500K, neutral), 100 = strongest (2500K, very warm).
#
# Two modes:
#   auto    nightlight-auto drives the intensity from the time of day. Setting
#           a value by hand parks an override until the next 07:00/19:00
#           boundary, then the schedule takes back over.
#   manual  nightlight-auto does nothing; whatever you set stays put.
#
# --auto is how nightlight-auto sets the value without arming an override.
# --mode only writes the setting; run nightlight-auto to apply it right away.
#
# WHAT CHANGED IN THE WAYLAND PORT
#
# The schedule, the override and the two modes are exactly as they were. Two
# things underneath them moved:
#
#   * Applying a temperature goes through ./gamma-apply, which owns the
#     question of what is holding the ramp. On Wayland something has to stay
#     alive to hold it — see that file's header — where on X11 redshift could
#     set it and exit.
#   * The current value lives in $KELVIN_FILE rather than in redshift.conf.
#     That file was only ever a convenient place to keep a number, and with
#     redshift out of the picture on Wayland it would have been a config for a
#     program nothing runs. It is still read once, as a fallback, so an
#     existing install carries its value across instead of snapping to neutral.
set -e
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/nightlight"
OVERRIDE="$STATE/override-until"
MODE_FILE="$STATE/mode"
KELVIN_FILE="$STATE/kelvin"
LEGACY_CONF="$HOME/.config/redshift/redshift.conf"
GAMMA_APPLY="$(cd "$(dirname "$0")" && pwd)/gamma-apply"

NEUTRAL=6500
PER_PERCENT=40

current_temp() {
    local temp
    temp=$(cat "$KELVIN_FILE" 2>/dev/null)
    if [[ "$temp" =~ ^[0-9]+$ ]]; then
        echo "$temp"
        return
    fi
    # One-time migration from the redshift.conf era.
    temp=$(grep -oP '(?<=^temp-day=)\d+' "$LEGACY_CONF" 2>/dev/null)
    if [[ "$temp" =~ ^[0-9]+$ ]]; then
        echo "$temp"
        return
    fi
    echo "$NEUTRAL"
}

# Anything unset or unrecognised means auto, so a missing/corrupt state file
# fails back to the scheduled behaviour rather than freezing the screen.
current_mode() {
    local m
    m=$(cat "$MODE_FILE" 2>/dev/null || true)
    case "$m" in
        manual) echo manual ;;
        *)      echo auto ;;
    esac
}

# Epoch of the next day/night transition, matching nightlight-auto's 07:00 and
# 19:00 edges.
next_boundary() {
    local h
    h=$(date +%-H)
    if [ "$h" -lt 7 ]; then
        date -d 'today 07:00' +%s
    elif [ "$h" -lt 19 ]; then
        date -d 'today 19:00' +%s
    else
        date -d 'tomorrow 07:00' +%s
    fi
}

if [ "${1:-}" = "--mode" ]; then
    shift
    if [ $# -eq 0 ]; then
        current_mode
        exit 0
    fi
    case "$1" in
        auto|manual) ;;
        *) echo "usage: nightlight --mode [auto|manual]" >&2; exit 1 ;;
    esac
    mkdir -p "$STATE"
    printf '%s\n' "$1" > "$MODE_FILE"
    # Either direction makes a pending hold meaningless.
    rm -f "$OVERRIDE"
    echo "night light mode: $1"
    exit 0
fi

auto=0
if [ "${1:-}" = "--auto" ]; then
    auto=1
    shift
fi

if [ $# -eq 0 ]; then
    temp=$(current_temp)
    pct=$(( (NEUTRAL - temp) / PER_PERCENT ))
    echo "current intensity: ${pct}% ($(current_mode), ${temp}K)"
    exit 0
fi

pct=$1
if ! [[ "$pct" =~ ^[0-9]+$ ]] || [ "$pct" -gt 100 ]; then
    echo "usage: nightlight [--auto] [0-100]" >&2
    exit 1
fi

temp=$((NEUTRAL - pct * PER_PERCENT))

# The value is recorded only once the screen has actually taken it. Writing
# first would leave the state claiming a temperature that never landed —
# which, with no gamma backend installed, is the difference between a clear
# error and a tray that lies about what you are looking at.
"$GAMMA_APPLY" "$temp"
mkdir -p "$STATE"
printf '%s\n' "$temp" > "$KELVIN_FILE"

# Only worth arming an override when there is a schedule to hold off.
if [ "$auto" -eq 0 ] && [ "$(current_mode)" = auto ]; then
    next_boundary > "$OVERRIDE"
    echo "night light set to ${pct}% (${temp}K), holding until $(date -d "@$(cat "$OVERRIDE")" '+%H:%M')"
else
    echo "night light set to ${pct}% (${temp}K)"
fi

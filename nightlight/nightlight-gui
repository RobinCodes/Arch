#!/bin/bash
# nightlight-gui — open the night light panel. Bound to Mod+N.
#
# Kept as a name rather than folded into nightlight-panel.py because the name is
# what the keybinding and the .desktop file point at, and both live outside this
# folder. The panel is the thing; this is the door with the old sign on it.
#
# What it used to be: a `yad` slider that read the current value out of
# ~/.config/redshift/redshift.conf. Both halves of that are gone — redshift.conf
# stopped being where the value lives when the state moved to
# ~/.local/state/nightlight, and yad draws an X11 dialog that matches nothing on
# this desktop. It had been reading a stale file and reporting a temperature the
# screen was not at.
exec "$(cd "$(dirname "$0")" && pwd)/nightlight-panel.py" "$@"

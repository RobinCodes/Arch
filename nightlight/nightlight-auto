#!/bin/bash
# nightlight-auto [--print] — sets night light intensity based on time of day.
# 19:00-07:00: held at PEAK.
# 07:00-19:00: smooth curve dipping to NOON at solar noon (13:00), rising back
#              to PEAK at the day/night boundaries (no jump).
#
# --print writes the intensity that should be on screen right now to stdout and
# touches nothing else. It exists for callers that must not go through
# nightlight: the login screen runs as root and has no business writing to this
# account's config, so it asks for the number and applies it itself. That keeps
# the curve below the only definition of the schedule.
NIGHTLIGHT="$(cd "$(dirname "$0")" && pwd)/nightlight"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/nightlight"
OVERRIDE="$STATE/override-until"
MODE_FILE="$STATE/mode"
KELVIN_FILE="$STATE/kelvin"
LEGACY_CONF="$HOME/.config/redshift/redshift.conf"

PEAK=100  # night-time intensity, as a % of nightlight's 0-100 scale (2500K)
NOON=35   # daytime minimum, reached at 13:00

print_only=0
if [ "$1" = "--print" ]; then
    print_only=1
    shift
fi

# The systemd user manager gets WAYLAND_DISPLAY and NIRI_SOCKET from niri's
# own `systemctl --user import-environment` at session start, so there is
# nothing to fake here the way the X11 version had to fake DISPLAY. If the
# variables are genuinely absent the session is not up and gamma-apply will
# say so rather than half-work.

# The intensity already on record, for --print in the cases where the schedule
# is not the one deciding. Falls back to the argument — the scheduled value —
# when the config is missing or unreadable, which beats guessing: a login screen
# at midday should not go night-warm just because a file went missing.
current_pct() {
    local temp
    temp=$(cat "$KELVIN_FILE" 2>/dev/null)
    [[ "$temp" =~ ^[0-9]+$ ]] || \
        temp=$(grep -oP '(?<=^temp-day=)\d+' "$LEGACY_CONF" 2>/dev/null)
    if [[ "$temp" =~ ^[0-9]+$ ]]; then
        echo $(( (6500 - temp) / 40 ))
    else
        echo "$1"
    fi
}

now=$(date +%H:%M)

sched=$(awk -v now="$now" -v peak="$PEAK" -v noon="$NOON" 'BEGIN {
    split(now, a, ":")
    t = a[1] + a[2] / 60
    pi = 3.14159265358979
    if (t >= 19 || t < 7) { print peak; exit }
    frac = (t - 7) / 12
    val = noon + (peak - noon) * (1 - sin(pi * frac))
    printf "%d\n", val + 0.5
}')

# Manual mode: the intensity is whatever the user last set, indefinitely.
# Only the literal string "manual" counts, so a missing or corrupt state file
# leaves the schedule running rather than silently disabling it.
if [ "$(cat "$MODE_FILE" 2>/dev/null || true)" = manual ]; then
    if [ "$print_only" -eq 1 ]; then
        current_pct "$sched"
    else
        echo "auto: ${now} -> skipped (manual mode)"
    fi
    exit 0
fi

# Someone moved the slider by hand; leave their value alone until the next
# day/night boundary, then take the schedule back over.
if [ -f "$OVERRIDE" ]; then
    until=$(cat "$OVERRIDE" 2>/dev/null || true)
    # Anything not a live timestamp (empty, truncated, stale) just falls
    # through and hands the schedule back.
    if [[ "$until" =~ ^[0-9]+$ ]] && [ "$(date +%s)" -lt "$until" ]; then
        if [ "$print_only" -eq 1 ]; then
            current_pct "$sched"
        else
            echo "auto: ${now} -> held by manual override until $(date -d "@$until" '+%H:%M')"
        fi
        exit 0
    fi
    # Only expire the hold when actually driving the screen. --print is a
    # question, not a turn of the schedule, and root asking it at the login
    # screen must not spend the override the session is about to want.
    [ "$print_only" -eq 1 ] || rm -f "$OVERRIDE"
fi

if [ "$print_only" -eq 1 ]; then
    echo "$sched"
    exit 0
fi

"$NIGHTLIGHT" --auto "$sched" >/dev/null
echo "auto: ${now} -> ${sched}%"

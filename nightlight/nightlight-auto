#!/bin/bash
# nightlight-auto [--print] — sets night light intensity from the time of day.
#
# THE CURVE
#
#   16:00 → 19:00   rise   0% → 80%
#   19:00 → 05:00   hold   80%          (across midnight)
#   05:00 → 06:30   fall   80% → 0%
#   06:30 → 16:00   hold   0%           (neutral; the screen is not tinted)
#
# Four times and one ceiling, all just below. Editing them is the supported way
# to change the schedule — nothing else in this repo has a copy of the curve.
# The tray's tooltip and step labels and the panel's "night" mark *read* these
# five lines rather than repeating them (nightlight-panel.py, `schedule`), so
# keep each one a plain NAME=number assignment at the start of its line.
#
# The two ramps are eased rather than straight lines. The endpoints are exactly
# the times above, so "0% at 06:30" and "80% at 19:00" hold literally; the
# easing only decides the shape between them. A straight ramp has a corner at
# each end, where the rate of change goes from nothing to its full value in one
# tick, and a corner is the part the eye actually catches — the screen looks
# still, then visibly starts moving. Smoothstep leaves and arrives at zero rate,
# so the ramp has no moment you can point at.
#
# --print writes the intensity that should be on screen right now to stdout and
# touches nothing else. It exists for callers that must not go through
# nightlight: the login screen runs as root and has no business writing to this
# account's config, so it asks for the number and applies it itself. That keeps
# the curve below the only definition of the schedule.
NIGHTLIGHT="$(cd "$(dirname "$0")" && pwd)/nightlight"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/nightlight"
MODE_FILE="$STATE/mode"
KELVIN_FILE="$STATE/kelvin"
LEGACY_CONF="$HOME/.config/redshift/redshift.conf"

# The ceiling the schedule ever reaches, as a % of nightlight's 0-100 scale, at
# 40K a percent down from 6500K. 80 lands at 3300K. It was 70 (3700K) and was
# raised for a warmer night; the last 20%, down to the 2500K deep amber at 100,
# is still left out of the schedule.
#
# This caps the *schedule* only. `nightlight 100` by hand still goes all the way
# and holds there until automatic mode is switched back on; the ceiling is what
# the automation chooses, not a limit on what you can ask for.
PEAK=80

# Decimal hours. 6.5 is 06:30.
RISE_START=16.0   # nothing before this: the day is neutral, not faintly warm
RISE_END=19.0     # at PEAK by here
FALL_START=5.0    # still at PEAK until here
FALL_END=6.5      # back to 0 by here

print_only=0
if [ "$1" = "--print" ]; then
    print_only=1
    shift
fi

# The systemd user manager gets WAYLAND_DISPLAY and NIRI_SOCKET from niri's own
# `systemctl --user import-environment` at session start, so there is nothing to
# fake here the way the X11 version had to fake DISPLAY. If the variables are
# genuinely absent the session is not up and gamma-apply will say so rather than
# half-work.

# The intensity already on record, for --print in the cases where the schedule
# is not the one deciding. Falls back to the argument — the scheduled value —
# when the state is missing or unreadable, which beats guessing: a login screen
# at midday should not go night-warm just because a file went missing.
current_pct() {
    local temp
    temp=$(cat "$KELVIN_FILE" 2>/dev/null)
    [[ "$temp" =~ ^[0-9]+$ ]] || \
        temp=$(grep -oP '(?<=^temp-day=)\d+' "$LEGACY_CONF" 2>/dev/null)
    if [[ "$temp" =~ ^[0-9]+$ ]]; then
        echo $(( (6500 - temp) / 40 ))
    else
        echo "$1"
    fi
}

now=$(date +%H:%M)

sched=$(awk -v now="$now" -v peak="$PEAK" \
            -v rs="$RISE_START" -v re="$RISE_END" \
            -v fs="$FALL_START" -v fe="$FALL_END" 'BEGIN {
    split(now, a, ":")
    t = a[1] + a[2] / 60

    if (t >= rs && t < re) {                  # evening rise
        u = (t - rs) / (re - rs)
        v = peak * (u * u * (3 - 2 * u))
    } else if (t >= fs && t < fe) {           # dawn fall
        u = (t - fs) / (fe - fs)
        v = peak * (1 - u * u * (3 - 2 * u))
    } else if (t >= re || t < fs) {           # night, across midnight
        v = peak
    } else {                                  # daytime, fe..rs
        v = 0
    }
    printf "%d\n", v + 0.5
}')

# Manual mode: the intensity is whatever was last set, indefinitely. Only the
# literal string "manual" counts, so a missing or corrupt state file leaves the
# schedule running rather than silently disabling it.
if [ "$(cat "$MODE_FILE" 2>/dev/null || true)" = manual ]; then
    if [ "$print_only" -eq 1 ]; then
        current_pct "$sched"
    else
        echo "auto: ${now} -> skipped (manual mode)"
    fi
    exit 0
fi

if [ "$print_only" -eq 1 ]; then
    echo "$sched"
    exit 0
fi

"$NIGHTLIGHT" --auto "$sched" >/dev/null
echo "auto: ${now} -> ${sched}%"
